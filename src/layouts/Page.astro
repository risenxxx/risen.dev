---
import sora from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url'
import manrope from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url'
import dmMono from '@fontsource/dm-mono/files/dm-mono-latin-400-normal.woff2?url'
import { site } from '../data/site.ts'
import '../styles/tokens.css'
import '../styles/fonts.css'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  noindex?: boolean
}

const { title = site.title, description = site.description, noindex = false } = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/og.png', Astro.site)
const preview = import.meta.env.SITE_PREVIEW === '1'

/*
  The one inline script on the page, and it runs before the first paint for a
  reason: `.js` is what switches the hidden half of every reveal on. Adding it
  from the module instead would render the page in its finished state and then
  blank it out, which is a flash of exactly the content the animation is meant
  to introduce.
*/
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || preview) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.domain} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Five products. Five domains. Every layer. Evgenii Zakharov, product engineer, risen.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Five products. Five domains. Every layer. Evgenii Zakharov, product engineer, risen.dev" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0A0A0C" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- The three faces the first screen is set in: display, body and the mono
         that carries the availability line and every caption. The previews'
         Rubik is discovered from the stylesheet and can arrive late. -->
    <link rel="preload" href={sora} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manrope} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmMono} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
