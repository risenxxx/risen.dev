---
import sans from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url'
import mono from '@fontsource-variable/martian-mono/files/martian-mono-latin-wght-normal.woff2?url'
import dmMono from '@fontsource/dm-mono/files/dm-mono-latin-400-normal.woff2?url'
import { ANALYTICS_SRC } from '../analytics.ts'
import { site } from '../data/site.ts'
import '../styles/tokens.css'
import '../styles/fonts.css'
import '../styles/global.css'
import '../styles/ascii.css'

interface Props {
  title?: string
  description?: string
  noindex?: boolean
  /** Keep the ASCII object at every width, not only where the landing has room beside its copy. */
  objectAlways?: boolean
}

const { title = site.title, description = site.description, noindex = false, objectAlways = false } = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/og.png', Astro.site)
const preview = import.meta.env.SITE_PREVIEW === '1'

/*
  The page's boot script, and it runs before the first paint for a
  reason: `.js` is what switches the hidden half of every reveal on. Adding it
  from the module instead would render the page in its finished state and then
  blank it out, which is a flash of exactly the content the animation is meant
  to introduce.

  `.ascii` and `.ascii-object` are decided here for the same reason: the ASCII
  layer is a deferred module, and the room the sections make for its object
  has to be there from the first paint, not appear when the module lands. The
  checks are the cheap ones — the API exists, motion is not reduced, the
  viewport is wide enough for an object beside the copy — and the module
  takes the classes back if a context cannot actually be had.

  The ASCII module is wanted the moment the page knows it can run it, not
  after the page's own script has arrived and asked for it: the hint fetches
  it alongside the fonts, one round trip sooner. At low priority, though —
  the page's own script and the fonts show the page, and on a thin
  connection the layer must not take their bandwidth. The path is put in by
  the build (astro.config.ts); in dev the placeholder stays and nothing is
  fetched ahead.
*/
const boot = `document.documentElement.classList.add('js')
if ('WebGL2RenderingContext' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
  document.documentElement.classList.add('ascii')
  if (${objectAlways ? 'true' : 'innerWidth >= 1000'}) document.documentElement.classList.add('ascii-object')
  if (!'__ASCII_CHUNK__'.startsWith('__')) {
    const l = document.createElement('link')
    l.rel = 'modulepreload'
    l.href = '__ASCII_CHUNK__'
    l.fetchPriority = 'low'
    document.head.append(l)
  }
}`

/*
  Analytics is Rybbit, and only on the production build: a preview or a dev
  server reporting its visits would count them against the real page.

  It comes from this domain (`/s/`, src/analytics.ts and worker/), so a
  blocker's host list has nothing to match and no second connection is
  opened. And it is not a <script defer> in the head, which is what the
  snippet asks for: deferred scripts run in document order with the page's
  own module, so the page's reveals — the hero copy among them, the largest
  paint — would wait on 35 KB of somebody else's script coming through the
  proxy; on a thin line it would take the bandwidth the fonts and the ASCII
  layer need. It is fetched after `load`, in idle time, instead. Nothing it measures is
  lost by that: the pageview is sent when it arrives, and the web vitals it
  can report are read from buffered performance entries. What is lost is a
  visitor who closes the tab before the page has finished loading, who was
  not reading it.

  The script tracks clicks on outbound links by itself. A mailto link has no
  host, so it is not one; the address carries data-rybbit-event instead.
*/
const analytics = import.meta.env.PROD && !preview
const rybbit = `addEventListener('load', () => (window.requestIdleCallback || setTimeout)(() => {
  const s = document.createElement('script')
  s.src = '${ANALYTICS_SRC}'
  document.head.append(s)
}))`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || preview) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.domain} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="One engineer. Every layer. Evgenii Zakharov, full-stack &amp; platform engineer, risen.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="One engineer. Every layer. Evgenii Zakharov, full-stack &amp; platform engineer, risen.dev" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0d0b" />
    <!-- The ICO first for the browsers that take no SVG (Safari among them),
         the SVG for those that do, and an opaque PNG for a home screen. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- The three faces the first screen is set in: display, body and the mono
         that carries the availability line and every caption. The previews'
         Rubik is discovered from the stylesheet and can arrive late. -->
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmMono} as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={boot} />
    {analytics && <script is:inline data-analytics set:html={rybbit} />}
  </head>
  <body>
    <slot />
  </body>
</html>
