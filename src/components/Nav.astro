---
import { contacts, nav, site } from '../data/site.ts'
import Icon from './Icon.astro'
import CvMenu from './CvMenu.astro'

const social = contacts.filter((c) => c.id !== 'email')
const email = contacts.find((c) => c.id === 'email')
---

<header class="bar">
  <div class="wrap row">
    <a class="mark" href="#top">{site.name}</a>

    <nav class="tabs" aria-label="Sections">
      {nav.map((item) => <a href={item.href} data-spy>{item.label}</a>)}
    </nav>

    <div class="right">
      {
        social.map((c) => (
          <a class="social" href={c.href} aria-label={c.label} rel="me noopener" target="_blank">
            <Icon name={c.icon} size={Math.round(20 * c.optical)} />
          </a>
        ))
      }
      {
        email && (
          <a class="social mail" href={email.href} aria-label={email.label}>
            <Icon name={email.icon} size={Math.round(20 * email.optical)} />
          </a>
        )
      }
      <CvMenu id="nav" class="cv" iconSize={15} align="end" />
    </div>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 40;
    /* Opaque on purpose. A translucent bar with `backdrop-filter: blur()` has
       to blur the page behind it again on every frame the page is scrolled,
       and on a long document that is the single most expensive thing on it. */
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .row {
    height: 74px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* The prompt: a tilde, then the name. */
  .mark {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 13px;
    white-space: nowrap;
  }

  .mark::before {
    content: "~ ";
    color: var(--amber);
  }

  /*
    The sections, as a terminal would list them: lowercase, spaced, nothing
    drawn round them. The one being read is printed as its path, `~/work`, in
    the amber, which is exactly how the label above its heading reads: the bar
    is the working directory. The `~/` is there on every tab and only shown on
    that one, so the row never changes width as the reader moves.
  */
  .tabs {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tabs a {
    font-family: var(--mono);
    font-size: 12.5px;
    text-transform: lowercase;
    color: var(--fg3);
    transition: color 0.18s;
  }

  .tabs a::before {
    content: "~/";
    color: var(--amber);
    opacity: 0;
    transition: opacity 0.18s;
  }

  .tabs a:hover {
    color: var(--fg);
  }

  .tabs a[aria-current] {
    color: var(--amber);
  }

  .tabs a[aria-current]::before {
    opacity: 1;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /*
    The marks are the buttons. Ringing them put a circle inside a circle for
    GitHub and Telegram and a circle around a square for LinkedIn, so the ring
    is gone; the 38 px target it used to draw is now padding that still exists
    but is not seen.
  */
  .social {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    color: var(--fg2);
    transition: color 0.18s;
  }

  .social:hover {
    color: var(--fg);
  }

  .right :global(.cv) {
    margin-left: 4px;
  }

  /* The tab strip is the first thing to go: the four anchors all exist as
     headings further down, and the contact buttons do not. */
  @media (max-width: 960px) {
    .tabs {
      display: none;
    }
  }

  /* The row stopped fitting at phone width and clipped the CV button. The
     same three links sit in the hero just below, so the bar keeps the one
     thing that is only here. */
  @media (max-width: 600px) {
    .right .social {
      display: none;
    }
  }

  /* The address is the one contact the bar keeps on a phone: there the hero's
     list of them is below the portrait, a screen and a half down. Wider, the
     hero shows it in the first screen, and the bar keeps to the profiles. */
  .right .mail {
    display: none;
  }

  @media (max-width: 600px) {
    .right .mail {
      display: grid;
    }
  }

  @media (max-width: 560px) {
    .right :global(.cv .btn) {
      font-size: 13px;
      padding: 0 12px;
    }

    .row {
      height: 64px;
      gap: 12px;
    }

    .right {
      gap: 2px;
    }
  }

  /* On a phone the bar's CV button is the label alone, the full-stack resume.
     The other two are one menu away at the end of the page, and the chevron
     here is what pushed the name onto a second line. */
  @media (max-width: 420px) {
    .right :global(.cv .cv-more) {
      display: none;
    }
  }
</style>
