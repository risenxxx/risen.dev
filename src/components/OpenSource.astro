---
import Icon from './Icon.astro'
import Sep from './Sep.astro'

/*
  Two, not a shelf. The archived experiments would pad the count and say nothing
  — and a list nobody uses is worse evidence than one library everybody does.
*/
const libraries = [
  {
    name: 'nestjs-zod',
    href: 'https://github.com/BenLorantfy/nestjs-zod',
    badge: 'installs a month',
    figure: '5.5M',
    stars: '1.1k',
    body: 'The standard way to use Zod with NestJS: one schema serves validation, TypeScript types and the generated OpenAPI docs, so the same data is never described twice. Written by me and transferred to another maintainer in 2024, still the ecosystem default.',
    meta: ['original author', 'TypeScript', 'MIT'],
  },
  {
    name: 'eslint-kit',
    href: 'https://github.com/eslint-kit/eslint-kit',
    stars: '130',
    status: 'maintained',
    body: 'Preset-based ESLint configuration — one short config instead of the usual sprawl of plugins, parsers and rules, across very different frontend and backend stacks. Still shipping releases, though Biome now covers much of the same ground in one binary.',
    meta: ['author', 'TypeScript', 'MIT'],
  },
]
---

<section class="oss">
  <div class="wrap">
    <h2 class="h-section" data-reveal>Open source</h2>
    <p class="lede">
      Two libraries still in the ecosystem, written and maintained by me.
    </p>

    <ul class="grid" data-reveal style="--dl: 1">
      {
        libraries.map((lib) => (
          <li>
            <a class="card" href={lib.href}>
              <div class="top">
                <h3>{lib.name}</h3>
                {lib.figure && (
                  <span class="tag good">
                    {lib.figure} {lib.badge}
                  </span>
                )}
                <span class="tag">
                  <Icon name="u-star-solid" size={12} />
                  {lib.stars}
                </span>
                {lib.status && <span class="tag">{lib.status}</span>}
              </div>
              <p class="body">{lib.body}</p>
              <p class="meta">
                {lib.meta.map((part, j) => (
                  <Fragment>
                    {j > 0 && <Sep />}
                    {part}
                  </Fragment>
                ))}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .oss {
    border-top: 1px solid var(--line);
    background: var(--s1);
    padding-block: clamp(44px, 5vw, 58px);
  }

  h2 {
    margin-bottom: 10px;
  }

  .lede {
    margin-bottom: 26px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .card {
    display: block;
    height: 100%;
    padding: 24px 22px;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  .card:hover {
    border-color: var(--line3);
    background: #16161b;
  }

  .top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 12px;
  }

  h3 {
    font-size: 20px;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg2);
    border: 1px solid var(--line2);
    border-radius: 999px;
    padding: 3px 10px;
  }

  .tag.good {
    color: var(--green);
    border-color: rgba(91, 216, 166, 0.35);
    background: rgba(91, 216, 166, 0.1);
  }

  .body {
    font-size: 15px;
    line-height: 1.6;
    color: #9c9ca6;
    margin-bottom: 16px;
  }

  .meta {
    display: flex;
    align-items: center;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--fg3);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
