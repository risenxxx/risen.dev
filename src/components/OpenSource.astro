---
import Icon from './Icon.astro'
import Sep from './Sep.astro'

/*
  Two, not a shelf. The archived experiments would pad the count and say nothing
  — and a list nobody uses is worse evidence than one library everybody does.
*/
const libraries = [
  {
    name: 'nestjs-zod',
    href: 'https://github.com/BenLorantfy/nestjs-zod',
    badge: 'installs a month',
    figure: '5.5M',
    stars: '1.1k',
    body: 'The standard way to use Zod with NestJS: one schema serves validation, TypeScript types and the generated OpenAPI docs, so the same data is never described twice. Written by me and transferred to another maintainer in 2024, still the ecosystem default.',
    meta: ['original author', 'TypeScript', 'MIT'],
  },
  {
    name: 'eslint-kit',
    href: 'https://github.com/eslint-kit/eslint-kit',
    stars: '130',
    status: 'archived',
    body: 'Preset-based ESLint configuration: one short config instead of the usual sprawl of plugins, parsers and rules, across very different frontend and backend stacks. Archived: Biome now covers the same ground in one binary.',
    meta: ['author', 'TypeScript', 'MIT'],
  },
]
---

<section class="oss" data-object="oss">
  <div class="wrap">
    <h2 class="h-section" data-path="~/open-source" data-reveal>Open source</h2>
    <p class="lede">
      Two libraries other people's projects depend on.<br class="br-wide" /> I wrote both; one is now in
      another maintainer's hands.
    </p>

    <ul class="grid" data-reveal style="--dl: 1">
      {
        libraries.map((lib) => (
          <li>
            <a class="card" href={lib.href} target="_blank" rel="noopener">
              <h3>{lib.name}</h3>
              <!-- The figures as lines of output: the note, then the number. -->
              <dl class="figs">
                {lib.figure && (
                  <div>
                    <dd>{lib.badge}</dd>
                    <dt>{lib.figure}</dt>
                  </div>
                )}
                <div>
                  <dd>stars</dd>
                  <dt>
                    <Icon name="u-star-solid" size={11} />
                    {lib.stars}
                  </dt>
                </div>
                {lib.status && (
                  <div>
                    <dd>status</dd>
                    <dt>{lib.status}</dt>
                  </div>
                )}
              </dl>
              <p class="body">{lib.body}</p>
              <p class="meta">
                {lib.meta.map((part, j) => (
                  <Fragment>
                    {j > 0 && <Sep />}
                    {part}
                  </Fragment>
                ))}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .oss {
    border-top: 1px solid var(--line);
    background: var(--s1);
    padding-block: clamp(44px, 5vw, 58px);
  }

  /* With the ASCII object the fill would hide it; the cards are in front
     of it on their own. On a tablet they keep two thirds of the width and
     the object rides the right third. */
  :global(html.ascii-object) .oss {
    background: transparent;
  }

  @media (min-width: 1000px) and (max-width: 1400px) {
    :global(html.ascii-object) .lede,
    :global(html.ascii-object) .grid {
      width: calc(100% - 272px);
    }
  }

  @media (min-width: 1000px) and (max-width: 1100px) {
    :global(html.ascii-object) .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  h2 {
    margin-bottom: 10px;
  }

  .lede {
    margin-bottom: 26px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .card {
    display: block;
    height: 100%;
    padding: 24px 22px;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  .card:hover {
    border-color: var(--line3);
    background: #16161b;
  }

  .top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 12px;
  }

  h3 {
    font-size: 20px;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    color: var(--fg2);
    border: 1px solid var(--line2);
    border-radius: 999px;
    padding: 3px 10px;
  }

  .tag.good {
    color: var(--green);
    border-color: rgba(91, 216, 166, 0.35);
    background: rgba(91, 216, 166, 0.1);
  }

  .body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg-body);
    margin-bottom: 16px;
  }

  .meta {
    display: flex;
    align-items: center;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--fg3);
  }

  @media (max-width: 1180px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /*
    The terminal profile. No card: a library is its name in the mono, its
    figures as lines of output, its text, and a comment line. The two sit
    side by side over two thirds of the width; the object has the rest.
  */
  .card {
    padding: 0;
  }

  .card:hover {
    border-color: transparent;
    background: transparent;
  }

  .card:hover h3 {
    color: var(--amber);
  }

  h3 {
    font-family: var(--mono);
    font-size: 16px;
    font-weight: 500;
    color: var(--fg);
    margin-bottom: 12px;
    transition: color 0.18s;
  }

  .figs {
    display: grid;
    gap: 3px;
    max-width: 320px;
    margin: 0 0 14px;
    font-family: var(--mono);
    font-size: 12.5px;
  }

  .figs > div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
    align-items: baseline;
  }

  .figs dd {
    margin: 0;
    color: var(--fg3);
  }

  .figs dt {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    justify-content: flex-end;
    font-weight: 500;
    color: var(--fg);
  }

  .figs dt :global(.ic) {
    color: var(--fg3);
  }

  .meta::before {
    content: "#";
    margin-right: 7px;
    color: var(--fg4);
  }

  .grid {
    gap: 40px;
  }

  @media (min-width: 1000px) {
    :global(html.ascii-object) .grid {
      width: calc(100% - 300px);
    }
  }
</style>
