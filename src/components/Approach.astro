---
import Icon from './Icon.astro'
import Sep from './Sep.astro'

/*
  Six steps in an order that matters, so they are drawn as a line with stops on
  it rather than six identical cards. A card grid would say these are six
  interchangeable features; the whole claim is that each one hands an artefact
  to the next.
*/
const stages = [
  {
    n: '01',
    key: 'SPEC',
    icon: 'u-spec',
    title: 'Acceptance cases first',
    body: 'The requirements, the constraints and the failing tests are written before implementation, including when an agent does most of the typing.',
  },
  {
    n: '02',
    key: 'CONTRACTS',
    icon: 'u-contracts',
    title: 'Types at every seam',
    body: 'One schema serves validation, types and the generated docs, so a broken state is impossible to express rather than merely unlikely.',
  },
  {
    n: '03',
    key: 'CI GATES',
    icon: 'u-flask',
    title: 'Tested against the real thing',
    body: 'Unit, integration and contract tests, Testcontainers against real PostgreSQL, Redis and NATS. Security and performance are gates, not follow-ups.',
  },
  {
    n: '04',
    key: 'DELIVERY',
    icon: 'u-branch',
    title: 'GitOps, not hands',
    body: 'FluxCD reconciles the cluster to the repository. Releases and rollbacks are the same operation, and both finish in under three minutes.',
  },
  {
    n: '05',
    key: 'INFRASTRUCTURE',
    icon: 'u-server',
    title: 'Written down, not clicked',
    body: 'Kubernetes on Talos Linux across bare metal and cloud, described in one Pulumi program, with secrets that never live in the repository.',
  },
  {
    n: '06',
    key: 'OPERATION',
    icon: 'u-gauge',
    title: 'It pages me first',
    body: 'Metrics, traces and structured logs on every service, SLOs with error budgets, and enough signal to know something is wrong before a user reports it.',
  },
]
---

<section id="approach">
  <div class="wrap">
    <div class="head" data-reveal>
      <div>
        <h2 class="h-section">From a plan to a running service</h2>
        <p class="lede">
          The same six steps on every product above, whether it ships to a cluster or to an installer. Each
          one produces an artefact the next one depends on.
        </p>
      </div>
      <p class="aside">a deploy is a reviewed commit,<br />never a hand on a terminal</p>
    </div>

    <ol class="steps">
      {
        stages.map((s, i) => (
          <li data-reveal style={`--dl: ${i}`}>
            <span class="marker" aria-hidden="true" />
            <p class="key">
              <Icon name={s.icon} size={14} />
              {s.n}
              <Sep />
              {s.key}
            </p>
            <h3>{s.title}</h3>
            <p class="body">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  section {
    border-top: 1px solid var(--line);
    background: var(--s1);
    padding-block: clamp(44px, 5vw, 62px);
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 38px;
  }

  h2 {
    margin-bottom: 10px;
  }

  .lede {
    max-width: 58ch;
  }

  .aside {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--fg3);
    text-align: right;
    flex: none;
  }

  /*
    No column gap: each step owns the rule above it, so the six rules meet and
    read as one line the sequence runs along. The separation is padding on the
    right of each step instead.
  */
  .steps {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .steps li {
    position: relative;
    border-top: 1px solid var(--line3);
    padding: 26px 26px 0 0;
  }

  .marker {
    position: absolute;
    top: -4px;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--fg);
  }

  /* The last stop is the thing actually running, so it is the one that is
     coloured rather than white. */
  .steps li:last-child .marker {
    background: var(--green);
  }

  .key {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    color: var(--fg3);
    margin-bottom: 10px;
  }

  h3 {
    font-size: 16px;
    margin-bottom: 8px;
  }

  .body {
    font-size: 13.5px;
    line-height: 1.55;
    color: #9c9ca6;
  }

  @media (max-width: 1180px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .steps li {
      padding-bottom: 28px;
    }
  }

  @media (max-width: 760px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
    }

    .aside {
      text-align: left;
    }

    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
