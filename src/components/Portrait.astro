---
/*
  The one photograph on the page.

  Encoded by `scripts/portrait.mjs` rather than copied in already built, because
  the source is framed looser than the hero wants and is cropped there first.
  The ladder is the two widths `sizes` names, at 1× and at 2×; a 3× screen gets
  the top of it rather than an enlargement.

  Not lazy, and fetched at high priority from the start: it is the first thing
  above the fold that is not text, and a portrait that arrives after the
  heading has already settled is worse than one that arrives with it. Without
  the hint an image starts low and is only promoted once layout has found it
  in the viewport; with it the request leaves with the fonts.
*/
/*
  The mosaic is the picture at 24 cells across, made by the same script and
  carried here as a data URI (about 2 KB): with the ASCII layer on, the style
  shows it, scaled up blocky and dimmed under a grid of cells, in the
  photograph's place until the layer's canvas is over it. See
  src/styles/ascii.css.
*/
import mosaic from '../portrait/mosaic.png?inline'

const widths = [300, 380, 600, 680]
const srcset = (ext: string) => widths.map((w) => `/assets/img/portrait-${w}.${ext} ${w}w`).join(', ')

/* The two sizes the hero ever draws it at, either side of the width where the
   portrait leaves the flow and becomes a column. The narrow one is the larger
   of the two: with nothing beside it, a small picture just looks stranded. */
const sizes = '(min-width: 861px) 300px, min(340px, 78vw)'
---

<picture style={`--mosaic: url(${mosaic})`}>
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
  <img
    src="/assets/img/portrait-680.jpg"
    srcset={srcset('jpg')}
    sizes={sizes}
    width="680"
    height="850"
    alt="Evgenii Zakharov"
    decoding="async"
    fetchpriority="high"
  />
</picture>

<style>
  picture,
  img {
    display: block;
    width: 100%;
    height: auto;
  }

  img {
    border-radius: 16px;
    border: 1px solid var(--line2);
    background: var(--s3);
  }
</style>
