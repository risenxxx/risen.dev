---
/*
  The one photograph on the page.

  Encoded by `scripts/portrait.mjs` rather than copied in already built, because
  the source is framed looser than the hero wants and is cropped there first.
  The ladder is the two widths `sizes` names, at 1× and at 2×; a 3× screen gets
  the top of it rather than an enlargement.

  Not lazy, and fetched at high priority from the start: it is the first thing
  above the fold that is not text, and a portrait that arrives after the
  heading has already settled is worse than one that arrives with it. Without
  the hint an image starts low and is only promoted once layout has found it
  in the viewport; with it the request leaves with the fonts.
*/
/*
  With the ASCII layer on, the style shows the portrait as a field of glyphs
  until the layer's canvas is over it: the characters in glyphs.txt, coloured
  by clipping mosaic.png (one pixel per glyph) to their ink. Both are made by
  the same script, at the grid the shader opens the run with, and carried
  here inline — about 3.5 KB, no request. See src/styles/ascii.css.
*/
import mosaic from '../portrait/mosaic.png?inline'
import glyphs from '../portrait/glyphs.txt?raw'

const widths = [300, 380, 600, 680]
const srcset = (ext: string) => widths.map((w) => `/assets/img/portrait-${w}.${ext} ${w}w`).join(', ')

/* The three sizes the hero draws it at: a column from a laptop up, a beat of
   its own between a phone and a laptop — the larger, since with nothing beside
   it a small picture just looks stranded — and a mark beside the heading on a
   phone, where the smallest rung is already more than a 3× screen needs. */
const sizes = '(min-width: 861px) 300px, (min-width: 561px) min(340px, 78vw), 72px'
---

<div class="frame" style={`--mosaic: url(${mosaic})`}>
  <picture>
    <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
    <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
    <img
      src="/assets/img/portrait-680.jpg"
      srcset={srcset('jpg')}
      sizes={sizes}
      width="680"
      height="850"
      alt="Evgenii Zakharov"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
  <pre class="ph" aria-hidden="true" set:text={glyphs} />
</div>

<style>
  .frame {
    position: relative;
    /* The glyph field is sized from this box (container units). */
    container-type: inline-size;
  }

  picture,
  img {
    display: block;
    width: 100%;
    height: auto;
  }

  img {
    border-radius: 0;
    border: 1px solid var(--line2);
    background: var(--s3);
  }
</style>
