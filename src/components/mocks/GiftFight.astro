---
/*
  The Telegram Mini App, rebuilt from its own source.

  The wheel is the real one: a donut of 140 / 40 user units, sectors coloured
  from `getSectorColors` (muted greens, blues and greys — the accent belongs to
  the pointer and the money, not to the board), the 145-unit rim, and the eight
  pixel lime pointer at the top. Around it the app's own primitives: the TON
  wallet pill, the points badge, the pot ValueBadge, a ContentCard holding the
  live bet feed, and the gradient Place-bet button.

  Two things here are about performance rather than looks. The rotation is on
  the <svg> ELEMENT, not on a group inside it: an element transform is handed to
  the compositor, while a transform on an inner <g> makes the browser re-raster
  the whole drawing every frame — and because this preview is itself inside a
  scaled box, that repaint took the text with it, which is what made the type
  shimmer while the wheel turned. For the same reason the wheel carries no
  drop-shadow filter: a filter over a rotating subtree is re-computed per frame.
*/
---

<div class="device" aria-hidden="true" data-scene data-dur="2200">
  <div class="screen">
    <span class="backdrop"></span>

    <div class="status">
      <span class="clock">4:21</span>
      <span class="island"><i></i></span>
      <span class="sys">
        <svg class="cell" viewBox="0 0 17 11">
          <rect x="0" y="7.4" width="3" height="3.6" rx="1.1"></rect>
          <rect x="4.67" y="5.1" width="3" height="5.9" rx="1.1"></rect>
          <rect x="9.33" y="2.7" width="3" height="8.3" rx="1.1"></rect>
          <rect x="14" y="0.4" width="3" height="10.6" rx="1.1"></rect>
        </svg>
        <svg class="wifi" viewBox="0 0 16 12">
          <path d="M1.1 4.1a10.1 10.1 0 0 1 13.8 0" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"></path>
          <path d="M4 7.1a6.1 6.1 0 0 1 8 0" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"></path>
          <circle cx="8" cy="10.2" r="1.55"></circle>
        </svg>
        <span class="batt">
          <b>63</b>
          <svg viewBox="4.2 1.8 14.6 20.4"><path d="M13.6 1.8 4.2 14.4h5.8l-1 7.8 9.8-12.8h-6z"></path></svg>
        </span>
      </span>
    </div>

    <div class="tg">
      <span class="close">
        <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg>
        Close
      </span>
      <span class="wordmark"><b>GIFT</b> FIGHT</span>
      <span class="tgbtns">
        <svg viewBox="0 0 24 24"><path d="M6 10l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        <i class="rule"></i>
        <span class="dots"><i></i><i></i><i></i></span>
      </span>
    </div>

  <div class="head">
      <span class="avatar">RZ</span>
      <span class="who">
        <span class="name">risenxx</span>
        <span class="points">1 240
          <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.5 19.5 12 12 21.5 4.5 12z"></path></svg>
        </span>
      </span>
      <span class="wallet">
        <svg class="ton" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="currentColor"></circle><path d="M7.4 8.2h9.2L12 17.4zM12 8.6v8.4" fill="none" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"></path></svg>
        <span class="ton-value">84.2</span>
        <span class="wbtns">
          <i><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg></i>
          <i><svg viewBox="0 0 24 24"><path d="M5 12h14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg></i>
        </span>
      </span>
    </div>

    <div class="wheelbox">
      <div class="wheelwrap">
        <span class="pointer"></span>
        <svg class="wheel" viewBox="-150 -150 300 300">
          <circle cx="0" cy="0" r="145" fill="none" stroke="rgba(168,255,53,0.28)" stroke-width="4"></circle>
          <path d="M 0 -40 L 0 -140 A 140 140 0 0 1 137.5 26.2 L 39.3 7.5 A 40 40 0 0 0 0 -40 Z" fill="rgba(34,85,34,0.8)"></path>
          <path d="M 39.3 7.5 L 137.5 26.2 A 140 140 0 0 1 8.8 139.7 L 2.5 39.9 A 40 40 0 0 0 39.3 7.5 Z" fill="rgba(21,32,60,0.8)"></path>
          <path d="M 2.5 39.9 L 8.8 139.7 A 140 140 0 0 1 -118.2 75 L -33.8 21.4 A 40 40 0 0 0 2.5 39.9 Z" fill="rgba(25,25,25,0.8)"></path>
          <path d="M -33.8 21.4 L -118.2 75 A 140 140 0 0 1 -133.1 -43.3 L -38 -12.4 A 40 40 0 0 0 -33.8 21.4 Z" fill="rgba(34,85,34,0.8)"></path>
          <path d="M -38 -12.4 L -133.1 -43.3 A 140 140 0 0 1 -75 -118.2 L -21.4 -33.8 A 40 40 0 0 0 -38 -12.4 Z" fill="rgba(21,32,60,0.8)"></path>
          <path d="M -21.4 -33.8 L -75 -118.2 A 140 140 0 0 1 0 -140 L 0 -40 A 40 40 0 0 0 -21.4 -33.8 Z" fill="rgba(25,25,25,0.8)"></path>

          <g class="seats">
            <g transform="translate(90.9,-75.2)"><circle r="15" stroke="#a8ff35"></circle><text class="ini" y="3.4">MK</text></g>
            <g transform="translate(78.1,88.5)"><circle r="15" stroke="#6c8cff"></circle><text class="ini" y="3.4">AI</text></g>
            <g transform="translate(-53.6,105.2)"><circle r="15" stroke="#e8e8ef"></circle><text class="ini" y="3.4">DV</text></g>
            <g transform="translate(-117.1,14.8)"><circle r="15" stroke="#3dd6c0"></circle><text class="ini" y="3.4">NK</text></g>
            <g transform="translate(-93.3,-72.3)"><circle r="15" stroke="#e24a8b"></circle><text class="ini" y="3.4">RZ</text></g>
            <g transform="translate(-33,-113.3)"><circle r="15" stroke="#ff8a3d"></circle><text class="ini" y="3.4">PL</text></g>
          </g>
        </svg>
        <span class="centre">24</span>
      </div>
    </div>

    <div class="stats">
      <span class="players">
        <span class="faces"><i>MK</i><i>AI</i><i>DV</i><i class="more">+3</i></span>
        6 players
      </span>
      <span class="pot">84.2 TON</span>
      <span class="fair">
        <svg viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path></svg>
        Provably fair<i class="sep"></i>verify round
      </span>
    </div>

    <div class="feed">
      <p class="live"><i></i>Bets</p>
      <div class="bet">
        <span class="face">NK</span>
        <span class="gift"><svg viewBox="0 0 24 24"><path d="M4 11h16v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM3 7h18v4H3zM12 7v13M12 7C10 7 7.5 4 9 3s3 3 3 4M12 7c2 0 4.5-3 3-4s-3 3-3 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg></span>
        <span class="what"><b>Plush Pepe</b><em>@nikita<i class="sep"></i>2s ago</em></span>
        <span class="value">21.4</span>
      </div>
      <div class="bet drop">
        <span class="face alt">AI</span>
        <span class="gift"><svg viewBox="0 0 24 24"><path d="M4 11h16v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM3 7h18v4H3zM12 7v13M12 7C10 7 7.5 4 9 3s3 3 3 4M12 7c2 0 4.5-3 3-4s-3 3-3 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg></span>
        <span class="what"><b>Durov’s Cap</b><em>@aiko<i class="sep"></i>9s ago</em></span>
        <span class="value">18.0</span>
      </div>
    </div>

    <div class="cta"><span>Place bet</span></div>

    <div class="tabs">
      <span><svg viewBox="0 0 24 24"><path d="M4 11l8-6 8 6v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path></svg>Home</span>
      <span><svg viewBox="0 0 24 24"><path d="M4 8h16v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM4 8l2-4h12l2 4M12 4v16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path></svg>Cases</span>
      <span class="on"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.6"></circle><circle cx="12" cy="12" r="2.4" fill="currentColor"></circle><path d="M12 4v3M12 17v3M4 12h3M17 12h3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>Roulette</span>
      <span><svg viewBox="0 0 24 24"><rect x="4" y="7" width="16" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"></rect><path d="M8 7V5h8v2M4 12h16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>Items</span>
      <span><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="3.4" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="M5 20a7 7 0 0 1 14 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>Profile</span>
    </div>

    <span class="home"></span>
  </div>
</div>
<style>
  /*
    A phone, not a rectangle with rounded corners: the app is a Telegram Mini
    App and is only ever seen inside one, so the frame, the status bar and the
    home indicator are part of what the product looks like. The bar across the
    top used to be a back arrow and three dots, which is not what Telegram
    draws — it draws a Close pill, the app's own wordmark, and a collapse
    button beside the menu.

    The screen clips nothing: the wheel is the one flexible row, so whatever
    height is left after the fixed chrome is what it gets.
  */
  .device {
    width: 364px;
    height: 100%;
    margin-inline: auto;
    padding: 10px;
    border-radius: 46px;
    background: #0b0b0d;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 30px 60px -28px rgba(0, 0, 0, 0.9);
    font-family: var(--ui);
    contain: content;
  }

  .screen {
    /* The tab bar's height, which the Place-bet button is anchored above. */
    --tabs: 65px;
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: 36px;
    overflow: hidden;
    background: #191623;
  }

  .backdrop {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0f0f10, #1a1a2e 55%, #16213e);
  }

  /* Everything that is a row. The two that are not — the button floating over
     the feed and the home indicator — are excluded by name, because this
     selector outranks their own `position` otherwise. */
  .screen > *:not(.backdrop):not(.cta):not(.home) {
    position: relative;
    flex: none;
  }

  /* ── the phone's own bar ─────────────────────────────────────────────── */

  /*
    Sized off the real one: the island is 125 of an iPhone's 393 points across,
    which on this screen is 108 — a little wider than the wordmark under it,
    which is what it looks like on the device. The bar is tall enough to leave
    the same air above the time as the phone does.
  */
  .status {
    height: 46px;
    display: flex;
    align-items: center;
    padding: 4px 27px 0 30px;
    color: #fff;
  }

  .clock {
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  /* The island is a cut-out in the panel, so it is the one black thing here. */
  .island {
    position: absolute;
    left: 50%;
    top: 9px;
    width: 108px;
    height: 32px;
    margin-left: -54px;
    border-radius: 999px;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 9px;
  }

  .island i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #121218;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .sys {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 5.5px;
  }

  .cell {
    width: 16.5px;
    height: 10.7px;
    fill: currentColor;
  }

  .wifi {
    width: 15px;
    height: 11.2px;
    fill: currentColor;
  }

  /* Charging, so the cell is full of colour rather than drawn as an outline,
     and it carries the reading the way iOS puts it inside the body. */
  .batt {
    position: relative;
    height: 13.5px;
    padding: 0 2px;
    border-radius: 5px;
    background: #5ec984;
    display: inline-flex;
    align-items: center;
    gap: 0.5px;
    color: #fff;
  }

  .batt::after {
    content: "";
    position: absolute;
    left: 100%;
    top: 50%;
    width: 1.8px;
    height: 4.6px;
    margin-top: -2.3px;
    border-radius: 0 1.2px 1.2px 0;
    background: rgba(255, 255, 255, 0.5);
  }

  /* Digits have no descender, so centring their box leaves them sitting above
     the middle of the cell. The nudge centres what is actually drawn. */
  .batt b {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    transform: translateY(0.5px);
  }

  /* Cropped to the glyph, so the width is the bolt and not its margins, and
     sized to stand as tall as the digits beside it rather than over them. */
  .batt svg {
    width: 6px;
    height: 8.4px;
    fill: currentColor;
  }

  /* ── the Mini App bar Telegram puts over it ──────────────────────────── */

  .tg {
    height: 40px;
    display: flex;
    align-items: center;
    padding: 0 12px;
  }

  .close {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 27px;
    padding: 0 11px 0 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.11);
    font-size: 12px;
    font-weight: 600;
    color: #fff;
  }

  .close svg {
    width: 12px;
    height: 12px;
  }

  .wordmark {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #fff;
  }

  .wordmark b {
    font-weight: 700;
    color: #a8ff35;
  }

  .tgbtns {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 27px;
    padding: 0 9px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.11);
    color: #fff;
  }

  .tgbtns > svg {
    width: 13px;
    height: 13px;
  }

  .rule {
    width: 1px;
    height: 13px;
    background: rgba(255, 255, 255, 0.22);
  }

  .dots {
    display: flex;
    gap: 2.5px;
  }

  .dots i {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
  }

  .home {
    position: absolute;
    left: 50%;
    bottom: 7px;
    width: 108px;
    height: 4px;
    margin-left: -54px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.85);
  }

  .head {
    display: flex;
    align-items: center;
    padding: 12px 14px;
  }

  /* Initials rather than an empty disc: a blank circle reads as a failed image. */
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #4a4468, #2e2a44);
    flex: none;
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 500;
    color: #c7c2e0;
    letter-spacing: 0.02em;
  }

  .who {
    margin-left: 10px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .name {
    font-size: 13px;
    font-weight: 500;
    color: #fff;
    line-height: 1;
  }

  .points {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 22px;
    padding: 0 9px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(232, 121, 249, 0.2), rgba(217, 70, 239, 0.2));
    border: 1px solid rgba(240, 171, 252, 0.3);
    font-size: 11.5px;
    font-weight: 500;
    color: #e879f9;
  }

  .points svg {
    width: 12px;
    height: 12px;
  }

  .wallet {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 7px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(0, 152, 234, 0.1), rgba(0, 136, 204, 0.1));
    border: 1px solid rgba(0, 152, 234, 0.2);
  }

  .ton {
    width: 20px;
    height: 20px;
    color: #0098ea;
  }

  .ton-value {
    font-size: 13px;
    font-weight: 600;
    color: #0098ea;
  }

  .wbtns {
    display: flex;
    gap: 2px;
  }

  .wbtns i {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(0, 152, 234, 0.14);
    display: grid;
    place-items: center;
  }

  .wbtns svg {
    width: 11px;
    height: 11px;
    color: #0098ea;
  }

  .wheelbox {
    flex: 1 1 auto !important;
    min-height: 190px;
    padding: 4px 14px 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .wheelwrap {
    position: relative;
    display: flex;
    justify-content: center;
    max-width: 100%;
    max-height: 100%;
  }

  .pointer {
    position: absolute;
    left: 50%;
    top: 2px;
    margin-left: -4px;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 8px solid #a8ff35;
    z-index: 2;
  }

  /*
    Three turns and a little, easing into the winner. The rotation lives on the
    element so the compositor owns it; the progress is the scene's, so it cannot
    run away on a slow frame.
  */
  .wheel {
    width: 262px;
    max-width: 100%;
    max-height: 100%;
    height: auto;
    aspect-ratio: 1;
    transform: rotate(calc(var(--p) * 1134deg));
    will-change: transform;
  }

  .seats circle {
    fill: #2a2740;
    stroke-width: 2.5;
  }

  /*
    The wheel turns, the initials do not: each one is given the rotation back so
    it stays upright, the way a name on a real board would be.
  */
  .seats .ini {
    text-anchor: middle;
    font-family: var(--ui);
    font-size: 9px;
    font-weight: 500;
    fill: #bdb7d4;
    transform-box: fill-box;
    transform-origin: center;
    transform: rotate(calc(var(--p) * -1134deg));
  }

  /* Over the wheel, not in it: anything inside the <svg> turns with the wheel. */
  .centre {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--ui);
    font-size: 20px;
    font-weight: 700;
    color: #fff;
    pointer-events: none;
  }

  .stats {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 10px 14px 0;
  }

  .players {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #9494a5;
  }

  .faces {
    display: flex;
  }

  .faces i {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid #12101b;
    background: #3a3550;
    display: grid;
    place-items: center;
    font-size: 8.5px;
    font-style: normal;
    font-weight: 500;
    color: #bdb7d4;
  }

  .faces i + i {
    margin-left: -8px;
    background: #45406b;
  }

  .faces i:nth-child(3) {
    background: #2f5a52;
  }

  .faces .more {
    background: linear-gradient(135deg, #a8ff35, #88dd20);
    font-size: 10px;
    font-weight: 700;
    color: #000;
  }

  .pot {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 18px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(168, 255, 53, 0.2), rgba(136, 221, 32, 0.2));
    border: 1px solid rgba(168, 255, 53, 0.3);
    font-size: 17px;
    font-weight: 500;
    color: #a8ff35;
  }

  .fair {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: #7d7e9b;
  }

  .fair svg {
    width: 12px;
    height: 12px;
  }

  .feed {
    margin: 10px 14px 0;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid #2e304d;
    border-radius: 16px;
    padding: 10px;
  }

  .live {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    font-weight: 500;
    color: #c0c1d9;
    margin-bottom: 10px;
  }

  .live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fd473a;
  }

  .bet {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
  }

  .bet + .bet {
    margin-top: 7px;
  }

  /* The newest bet slides in from the left, the way the real feed animates it. */
  .drop {
    opacity: calc((var(--p) - 0.72) * 5);
    transform: translateX(calc((1 - clamp(0, (var(--p) - 0.72) * 5, 1)) * -16px));
  }

  .face,
  .gift {
    width: 28px;
    height: 28px;
    flex: none;
    display: grid;
    place-items: center;
