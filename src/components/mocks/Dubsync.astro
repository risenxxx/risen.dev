---
/*
  dubsync as a timeline: the master's English track, the donor's English track,
  and the donor's dub that rides along with it.

  The two English tracks are the same soundtrack, which is the whole trick: the
  donor's copy is the one that can be compared with the master, and wherever it
  differs — here two ad breaks, three seconds of black and silence each — the
  donor has material the master does not. The scene removes those regions for
  real: each break collapses to nothing and the rest of the track slides left
  until it sits under the master. The dub is on the donor's clock, so the same
  cuts happen to it in the same frames; it is never compared with anything, it
  just follows. The readout at the bottom is the part that matters most: a
  confidence score, so a bad match is reported rather than shipped.

  Everything is drawn in pixels of the 526 px lane, so a segment's viewBox is
  its own width and nothing is stretched sideways when it moves.
*/

const W = 526
const STEP = 9

/** Bar heights for one soundtrack: one per STEP px, across the whole lane. */
const bars = (seed: number, amp: number): number[] =>
  Array.from({ length: Math.ceil((W - 5) / STEP) }, (_, i) => amp * (0.35 + 0.65 * Math.abs(Math.sin(i * 1.7 + seed))))

/** The bars that fall in [from, to), as a path measured from `from`. */
const slice = (hs: number[], from: number, to: number): string => {
  let d = ''
  hs.forEach((h, i) => {
    const x = 5 + i * STEP
    if (x >= from && x < to) d += `M${x - from} ${38 - h}V${38 + h}`
  })
  return d
}

// Where the master's timeline has the donor's two ad breaks, halfway between
// bars so no stroke is split by a cut, and how wide each break is on the
// ruler's scale (10.55 px a second).
const A = 144.5
const B = 342.5
const G1 = 32
const G2 = 33

const eng = bars(0.6, 28)
const dub = bars(2.3, 24)

/** A donor lane: three pieces of soundtrack with a break between each pair. */
const donor = (hs: number[]) => [
  { cls: 's0', left: 0, w: A, d: slice(hs, 0, A) },
  { cls: 'gap g1', left: A, w: G1, d: '' },
  { cls: 's1', left: A + G1, w: B - A, d: slice(hs, A, B) },
  { cls: 'gap g2', left: B + G1, w: G2, d: '' },
  { cls: 's2', left: B + G1 + G2, w: W - B, d: slice(hs, B, W) },
]
---

<div class="app" aria-hidden="true" data-scene data-dur="2600" data-ease="linear" style={`--g1: ${G1}px; --g2: ${G2}px`}>
  <div class="bar">
    <span class="dots"><i></i><i></i><i></i></span>
    <span class="name">dubsync</span>
    <span class="themes"><i>System</i><i class="on">Dark</i><i>Light</i></span>
  </div>

  <div class="tools">
    <span class="file">master.2160p.mkv</span>
    <svg class="swap" viewBox="0 0 24 24"><path d="M4 9h16l-3-3M20 15H4l3 3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    <span class="file">donor.dvdrip.mkv</span>
    <span class="run">Run sync</span>
  </div>

  <div class="timeline">
    <div class="ruler">
      <span class="gutter"></span>
      <span class="ticks"><i>00:00</i><i>00:20</i><i>00:40</i></span>
    </div>

    <div class="lane">
      <span class="gutter">
        <b>MASTER</b>
        <span class="track-name">eac3 5.1<i class="sep"></i>eng</span>
        <em>anchor track</em>
      </span>
      <span class="wave">
        <svg class="piece" style={`width: ${W}px`} viewBox={`0 0 ${W} 76`} preserveAspectRatio="none"><path class="master" d={slice(eng, 0, W)}></path></svg>
      </span>
    </div>

    <div class="lane">
      <span class="gutter">
        <b>DONOR</b>
        <span class="track-name">ac3 2.0<i class="sep"></i>eng</span>
        <em>2 ad breaks</em>
      </span>
      <span class="wave">
        {
          donor(eng).map((p) =>
            p.d ? (
              <svg class:list={['piece', p.cls]} style={`left: ${p.left}px; width: ${p.w}px`} viewBox={`0 0 ${p.w} 76`} preserveAspectRatio="none">
                <path class="master" d={p.d} />
              </svg>
            ) : (
              <i class={p.cls} style={`left: ${p.left}px; width: ${p.w}px`} />
            ),
          )
        }
      </span>
    </div>

    <div class="lane dub">
      <span class="gutter">
        <b>DONOR</b>
        <span class="track-name">ac3 2.0<i class="sep"></i>fre dub</span>
        <em class="follow">same cuts applied</em>
      </span>
      <span class="wave">
        {
          donor(dub).map((p) =>
            p.d ? (
              <svg class:list={['piece', p.cls]} style={`left: ${p.left}px; width: ${p.w}px`} viewBox={`0 0 ${p.w} 76`} preserveAspectRatio="none">
                <path class="donor" d={p.d} />
              </svg>
            ) : (
              <i class={p.cls} style={`left: ${p.left}px; width: ${p.w}px`} />
            ),
          )
        }
      </span>
    </div>

    <span class="playhead"></span>
    <span class="playhandle"></span>
  </div>

  <div class="readout">
    <span class="result">3 / 3 segments aligned<i class="sep"></i>2 breaks cut, −6.1 s<i class="sep"></i>PSR 9.4</span>
    <span class="confident">confident</span>
  </div>
</div>

<style>
  /*
    `--p` is plain time (`data-ease="linear"`) and each break eases itself on a
    smoothstep: the first moment is left still so the breaks are seen before
    they go, then one closes, and the second starts as the first settles.
    `--t1` and `--t2` live on the root because both donor lanes read them — the
    dub is cut in the same frames as the track it depends on.
  */
  .app {
    --a1: clamp(0, (var(--p) - 0.16) / 0.3, 1);
    --t1: calc(var(--a1) * var(--a1) * (3 - 2 * var(--a1)));
    --a2: clamp(0, (var(--p) - 0.42) / 0.3, 1);
    --t2: calc(var(--a2) * var(--a2) * (3 - 2 * var(--a2)));
    width: 660px;
    height: 372px;
    border-radius: 12px;
    overflow: hidden;
    background: #1b1b1f;
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    box-shadow: var(--sh-mock);
    font-family: var(--sans);
  }

  .bar {
    flex: none;
    height: 34px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 12px;
    background: #242429;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3a3a40;
  }

  .name {
    font-size: 12.5px;
    color: #d6d6da;
    margin-left: 4px;
  }

  .themes {
    margin-left: auto;
    display: flex;
    gap: 4px;
    font-size: 11px;
  }

  .themes i {
    padding: 3px 9px;
    border-radius: 5px;
    color: #9a9aa2;
    font-style: normal;
  }

  .themes .on {
    background: #2f6fbf;
    color: #fff;
  }

  .tools {
    flex: none;
    height: 38px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    font-family: var(--mono);
    font-size: 11px;
  }

  .file {
    color: #d6d6da;
  }

  .swap {
    width: 14px;
    height: 14px;
    color: #a855f7;
  }

  .run {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 11px;
    border-radius: 6px;
    background: #a855f7;
    color: #120a1c;
    font-weight: 500;
  }

  .timeline {
    flex-grow: 1;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .ruler,
  .lane {
    display: flex;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .ruler {
    flex: none;
    height: 24px;
  }

  .lane {
    flex: none;
    height: 76px;
  }

  .lane.dub {
    flex: 1 1 auto;
    height: auto;
    border-bottom: 0;
  }

  .gutter {
    width: 132px;
    flex: none;
    border-right: 1px solid rgba(255, 255, 255, 0.07);
    padding: 12px 12px 0;
  }

  .gutter b {
    display: block;
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: #78787f;
  }

  .track-name {
    display: block;
    margin-top: 5px;
    font-size: 12px;
    color: #d6d6da;
  }

  .gutter em {
    display: block;
    margin-top: 3px;
    font-family: var(--mono);
    font-size: 10px;
    font-style: normal;
    color: #6e6e75;
  }

  .gutter .follow {
    color: #c084fc;
    opacity: clamp(0, var(--t1) * 3, 1);
  }

  .ticks {
    flex-grow: 1;
    position: relative;
    background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.14) 0 1px, transparent 1px 52.6px);
  }

  .ticks i {
    position: absolute;
    top: 5px;
    font-family: var(--mono);
    font-size: 9.5px;
    font-style: normal;
    color: #78787f;
  }

  .ticks i:nth-child(1) {
    left: 6px;
  }

  .ticks i:nth-child(2) {
    left: 217px;
  }

  .ticks i:nth-child(3) {
    left: 428px;
  }

  .wave {
    flex-grow: 1;
    position: relative;
    background: #17171a;
    overflow: hidden;
  }

  .piece {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
  }

  .master,
  .donor {
    stroke-width: 5;
    stroke-linecap: round;
    fill: none;
  }

  .master {
    stroke: #6e6e78;
  }

  .donor {
    stroke: #a855f7;
  }

  /*
    An ad break: black picture, so silence — a flat line through hatching. It
    is removed rather than marked: it folds to zero width from its left edge
    while everything after it moves left by exactly what it gives up, so the
    track closes over the hole instead of a box being drawn on top of it.
  */
  .gap {
    position: absolute;
    top: 6px;
    bottom: 6px;
    border-radius: 3px;
    background:
      linear-gradient(rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.28)) center / 100% 1px no-repeat,
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.07) 0 2px, transparent 2px 6px),
      #0e0e10;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    transform-origin: left center;
  }

  .g1 {
    transform: scaleX(calc(1 - var(--t1)));
  }

  .s1 {
    transform: translateX(calc(var(--t1) * var(--g1) * -1));
  }

  .g2 {
    transform: translateX(calc(var(--t1) * var(--g1) * -1)) scaleX(calc(1 - var(--t2)));
  }

  .s2 {
    transform: translateX(calc((var(--t1) * var(--g1) + var(--t2) * var(--g2)) * -1));
  }

  .playhead {
    position: absolute;
    left: 44%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(255, 255, 255, 0.55);
  }

  .playhandle {
    position: absolute;
    left: 44%;
    top: 0;
    width: 9px;
    height: 9px;
    margin-left: -4px;
    background: rgba(255, 255, 255, 0.8);
  }

  .readout {
    flex: none;
    height: 38px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    background: #1f1f23;
    font-family: var(--mono);
    font-size: 11px;
    color: #9a9aa2;
  }

  /* The verdict is only stated once the run has earned it. */
  .result,
  .confident {
    opacity: clamp(0, (var(--p) - 0.74) / 0.12, 1);
  }

  .confident {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 10px;
    border-radius: 999px;
    background: rgba(74, 222, 155, 0.12);
    border: 1px solid rgba(74, 222, 155, 0.4);
    color: #4ade9b;
  }

  .sep {
    display: inline-block;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
    vertical-align: middle;
    margin-inline: 8px;
  }
</style>
