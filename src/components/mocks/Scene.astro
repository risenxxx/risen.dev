---
/*
  The picture inside the previews: one drawn night landscape, reused.

  Frame Player needs something on screen and DeskVolt needs a wallpaper behind
  its widget. A photograph would mean shipping a bitmap and claiming a frame of
  a film that does not exist, and a gradient standing in for one reads as a
  placeholder. So the scene is drawn — sky, stars, seven ridges and the fog
  between them — and each preview shows a different part of it, which is also
  what two moments of the same film would look like.

  Rendered once into the document as `#scene-night`, then referenced. The paths
  came out of `scripts/scene.py`; rerun that to change the terrain.
*/
interface Props {
  /** A `viewBox` into the 1600 x 760 scene: which part of it to show. */
  view?: string
  /** Emit the scene itself. Exactly one of these goes in the document. */
  defs?: boolean
  class?: string
}

const { view, defs = false, class: cls } = Astro.props
---

