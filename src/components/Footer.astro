---
import { site } from '../data/site.ts'
import Sep from './Sep.astro'

const year = new Date().getFullYear()
---

<footer>
  <div class="wrap row">
    <span class="mark">risen<span>.dev</span></span>

    <!-- The colophon used to recite the stack and the byte count. The README
         has them; the footer keeps the one thing a reader might want to
         follow, the source. -->
    <p class="colophon">
      Built with Astro
      <Sep />
      <a href={site.repo} target="_blank" rel="noopener">source</a>
    </p>

    <p class="rights">© {year} {site.name}</p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    background: #08080a;
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 28px;
  }

  .mark {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 13px;
  }

  .mark::before {
    content: "~/";
    color: var(--amber);
  }

  .mark span {
    color: var(--fg3);
  }

  .colophon {
    max-width: 62ch;
  }

  .colophon,
  .rights {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--fg3);
  }

  .colophon a {
    color: var(--fg2);
    border-bottom: 1px solid rgba(163, 163, 173, 0.4);
  }

  .colophon a:hover {
    color: var(--fg);
    border-bottom-color: var(--fg);
  }

  @media (max-width: 1080px) {
    .row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>
