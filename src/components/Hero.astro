---
import { contactEvent } from '../analytics.ts'
import { contacts, site } from '../data/site.ts'
import Icon from './Icon.astro'
import CopyText from './CopyText.astro'
import CvMenu from './CvMenu.astro'
import Portrait from './Portrait.astro'
import Sep from './Sep.astro'

/*
  A person, then what they have built — in that order and on that axis.

  The copy used to be centred, which is the one arrangement that cannot hold a
  portrait beside it: a centred column has no edge for anything to sit against,
  so a photograph next to it reads as an ornament rather than as the subject.
  Everything on the page below now shares this left edge.

  The markup is the phone's layout, in reading order: the state, then the face
  and the claim side by side, the evidence, and the two things to do about it.
  A phone gets the portrait as a small square beside the heading rather than a
  beat of its own: at full width it was a screen of face between the sentence
  and the buttons, and the buttons fell below the fold. The other layouts are
  laid over the same markup — the face and the heading's wrapper dissolves
  (`display: contents`) — which is the only way the portrait can be a column
  beside the copy at one width, a beat inside it at another and a mark beside
  the heading at a third, without the page carrying two copies of the heading.
*/
---

<section class="hero" id="top" data-object="top">
  <div class="wrap copy">
    <p class="pill" data-reveal style="--dl: 1">
      <span class="live" aria-hidden="true"></span>
      Open to senior engineering roles
      <span class="when"><Sep /> {site.availability}</span>
    </p>
    <!-- The phone's version of the line's tail and of the portrait's caption,
         which have no room there: one is past the width of the screen, the
         other is under a 72 px portrait. -->
    <p class="sub mono" data-reveal style="--dl: 1">
      <span class="when">{site.availability}</span>
      <span>{site.location}, {site.timezone}<Sep tight />{site.hours}</span>
    </p>

    <div class="head">
      <!-- Revealed first, because on the wide layout it is the leftmost thing on
           the page and a column that fades in after its own text reads as late. -->
      <figure class="me" data-reveal>
        <Portrait />
        <figcaption class="mono">{site.location}<Sep tight />{site.timezone}<Sep tight />{site.hours}</figcaption>
      </figure>
      <h1 data-reveal style="--dl: 2">
        <!-- The space belongs after the break: at the start of a line it is
             collapsed away. -->
        One engineer.<br /> Every layer.
      </h1>
    </div>

    <p class="lede" data-reveal style="--dl: 3">
      <strong>Full-stack and platform engineer.</strong> Eight years taking products from a blank plan to a running service,
      with interfaces people feel the quality of, and the numbers to prove it. In teams
      at X5 Group and SberEducation, on products at up to 7.5M monthly users. On my own, Tuned, a resume SaaS
      from first commit to payments in five weeks. And the{' '}
      <a class="proof" href="https://github.com/BenLorantfy/nestjs-zod/commits?author=risenxxx" target="_blank" rel="noopener"
        >original author</a
      >{' '}of{' '}
      <a
        class="oss"
        href="https://github.com/BenLorantfy/nestjs-zod"
        target="_blank"
        rel="noopener"
        aria-label="nestjs-zod on GitHub, 1.1k stars"><span class="nm">nestjs-zod</span><span class="stars mono" aria-hidden="true"><Icon name="u-star-solid" size={12} />1.1k</span></a>, at 5.5M installs a&nbsp;month.
    </p>

    <div class="cta" data-reveal style="--dl: 4">
      <a class="btn btn-primary btn-lg" href="#work">See the work</a>
      <CvMenu id="hero" large />
    </div>

    <ul class="ids" data-reveal style="--dl: 5">
      {
        contacts.map((c) => (
          <li>
            <a
              class="btn btn-id"
              href={c.href}
              rel={c.id === 'email' ? undefined : 'me noopener'}
              target={c.id === 'email' ? undefined : '_blank'}
              {...contactEvent(c.id, 'hero')}
            >
              <Icon name={c.icon} size={Math.round(16 * c.optical)} />
              {c.label}
            </a>
            {c.id === 'email' && <CopyText text={site.email} from="hero" />}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(48px, 6vw, 76px) 0 clamp(48px, 5.5vw, 72px);
  }

  /*
    Narrow first: one column, in the order the markup is written. The portrait
    sits under the sentence that earns it and above the two buttons, which is
    where it stops being a decoration in the corner and starts being the thing
    the page is about.
  */
  .copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  /* A grid item stretches to its column, and a stretched pill is a capsule the
     width of the page. Everything else here wants the full column: the headings
     and the paragraph wrap against it, and the two button rows lay themselves
     out from the left already. */
  .pill {
    justify-self: start;
  }

  /* Only a box on a phone (see the bottom of this sheet); everywhere else its
     two children are items of the grid like the rest of the copy. */
  .head {
    display: contents;
  }

  /* After the state, in the page's own grey: a fact about it, not a second
     state. */
  .pill .when {
    display: inline-flex;
    align-items: center;
    color: var(--fg2);
  }

  .pill .when :global(.sep) {
    margin-inline: 9px;
    font-size: 1em;
  }

  /* Up to a narrow laptop the fact takes a line of its own under the state,
     lined up with its words (7 px of cursor, 9 px of gap): on one line it ran
     into the object standing to the right of the copy. */
  @media (min-width: 561px) and (max-width: 1200px) {
    .pill {
      flex-wrap: wrap;
      row-gap: 4px;
    }

    .pill .when {
      flex-basis: 100%;
      padding-left: 16px;
    }

    .pill .when :global(.sep) {
      display: none;
    }
  }

  .sub {
    display: none;
  }

  .me {
    display: flex;
    flex-direction: column;
    gap: 13px;
    /* Wide enough to be a face rather than a thumbnail, and never wider than
       the gutters leave. */
    width: min(340px, 78vw);
    margin: 34px auto 0;
    text-align: center;
  }

  .me figcaption {
    font-size: 11.5px;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: var(--fg3);
  }

  h1 {
    margin: 22px 0 20px;
    /*
      No measure here on purpose: the break in the markup is the line break,
      and the column the copy sits in is the only other constraint.

      Larger than it was, because the heading is shorter than it was. Counting
      the products put a number on the page that was always going to be wrong —
      five is what has a section here, not what has been built — so the claim
      is the two things that are true however many there turn out to be.
    */
    font-size: clamp(40px, 5.2vw, 66px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.037em;
  }

  /* Plain wrapping, not the paragraphs' `pretty`: Safari's `pretty` breaks the
     line after the unbreakable star badge early, leaving a line half empty and
     "installs a month." on one of its own. The no-break space in "a month"
     keeps the last word from standing alone, which is all `pretty` did here
     in Chrome. */
  .lede {
    text-wrap: wrap;
  }

  /* The role, said once in words: the heading is the claim, this is the job
     title a recruiter is scanning for. */
  .lede strong {
    font-weight: 500;
    color: var(--fg);
  }

  /*
    The one library worth naming up here, as a link with its star count
    beside it: the name underlined the way the log's links are, the count a
    small square tag in the mono with the amber star — the only badge on
    the page, and it carries a number a reader can check.
  */
  .oss {
    color: var(--fg);
    white-space: nowrap;
  }

  /* The proof of the claim, a step ahead of the repository: the repository
     now lists another maintainer, so "original author" opens the author's
     own commits, from the first one. */
  .proof {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.32);
    transition: text-decoration-color 0.18s;
  }

  .proof:hover {
    text-decoration-color: var(--fg);
  }

  .oss .nm {
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.32);
    transition: text-decoration-color 0.18s;
  }

  .oss:hover .nm {
    text-decoration-color: var(--fg);
  }

  .stars {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-left: 7px;
    padding: 1px 6px;
    border: 1px solid var(--line3);
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--fg);
    transition: border-color 0.18s;
  }

  .stars :global(.ic) {
    color: var(--amber);
  }

  .oss:hover .stars {
    border-color: var(--fg3);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 32px 0 20px;
  }

  .ids {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /*
    Between a phone and a laptop the portrait is still a beat of its own, after
    the sentence that earns it and before the buttons, as the narrow layout
    always had it; the markup now puts it with the heading, so the order is
    said here.
  */
  @media (min-width: 561px) and (max-width: 860px) {
    .me {
      order: 1;
    }

    .cta,
    .ids {
      order: 2;
    }
  }

  /*
    A phone: the portrait as a square mark beside the heading, about its two
    lines high, so the face is on the first screen and so are the buttons. The
    caption goes, having no room at 72 px; `.sub` under the state says it
    instead.

    The heading keeps its break and its two lines, and the size it is set at
    is what the column beside the portrait leaves for "One engineer." — the
    gutters, the portrait and the gap come to 132 px, and the line is 6.3 ems
    long — so a narrow phone gets a smaller heading rather than a third line.
  */
  @media (max-width: 560px) {
    .pill .when {
      display: none;
    }

    /* Under the state, lined up with its words rather than with its cursor
       (7 px of cursor, 9 px of gap). */
    .sub {
      display: flex;
      flex-direction: column;
      margin: 6px 0 0 16px;
      font-size: 12px;
      line-height: 1.6;
      text-transform: lowercase;
      color: var(--fg3);
    }

    .sub .when {
      color: var(--fg2);
    }

    .head {
      display: flex;
      align-items: center;
      gap: 16px;
      margin: 22px 0 20px;
    }

    .me {
      width: 72px;
      margin: 0;
      flex: none;
    }

    .me figcaption {
      display: none;
    }

    h1 {
      margin: 0;
      min-width: 0;
      font-size: min(40px, calc((100vw - 132px) / 6.3));
    }
  }

  /* The address and the button that copies it, on one line. */
  .ids li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  /* With the ASCII object beside it, and the page's own layout still the
     desktop one, the lede gives up some measure so the two do not meet. */
  @media (min-width: 1181px) and (max-width: 1400px) {
    :global(html.ascii-object) .lede {
      max-width: 460px;
    }
  }

  /* Until the page reaches its 1440 px the object's lane narrows with the
     screen faster than the copy does. */
  @media (min-width: 1401px) and (max-width: 1440px) {
    :global(html.ascii-object) .lede {
      max-width: 600px;
    }
  }

  @media (min-width: 1441px) {
    :global(html.ascii-object) .lede {
      max-width: 56ch;
    }
  }

  /*
    From a laptop up the portrait leaves the flow and becomes the left column,
    spanning every row of the copy. The copy is the taller of the two at every
    width this applies at — four lines of lede and two of heading clear the
    portrait's 375 — so the rows are sized by the text and the figure hangs
    from the top of them.
  */
  @media (min-width: 861px) {
    .copy {
      grid-template-columns: 300px minmax(0, 1fr);
      /*
        The five rows are the five things in column two, and they are declared
        rather than implied: `grid-row: 1 / -1` counts lines of the EXPLICIT
        grid, so against implicit rows `-1` is line 1 and the portrait collapses
        into the first row — which it then stretches to its own height, drawing
        the availability pill as a 400 px capsule.
      */
      grid-template-rows: repeat(5, auto);
      column-gap: clamp(32px, 4vw, 52px);
      align-content: start;
    }

    .copy > :not(.head),
    .head > h1 {
      grid-column: 2;
    }

    .me {
      grid-column: 1;
      grid-row: 1 / -1;
      align-self: start;
      width: 300px;
      margin: 0;
      text-align: left;
    }
  }
</style>
