---
import { contacts, site } from '../data/site.ts'
import Icon from './Icon.astro'
import CvMenu from './CvMenu.astro'
import Sep from './Sep.astro'

/* The second ask, and the shortest. The first is a button in the navigation,
   before anybody has a reason to press it; what I am looking for is written out
   in `Now`, near the top, where somebody deciding whether to read on needs it.
   By here the only thing left to say is the address, and the calendar for
   whoever would rather talk than write. */
const social = contacts.filter((c) => c.id !== 'email')
---

<section id="contact" data-object="contact">
  <div class="wrap inner">

    <h2 class="h-section" data-path="~/contact" data-reveal style="--dl: 1">Write to me</h2>

    <p class="lede" data-reveal style="--dl: 2">
      Senior product, full-stack or platform roles, contract work, and one-off architecture reviews.
      The terms are up at <a href="#now">Looking for the next team</a>.
    </p>

    <div class="cta" data-reveal style="--dl: 3">
      <a class="btn btn-primary btn-lg" href={`mailto:${site.email}`}>
        <Icon name="b-mail" />
        {site.email}
      </a>
      <a class="btn btn-ghost btn-lg" href={site.call} target="_blank" rel="noopener">Book a call</a>
      <CvMenu id="contact" large />
    </div>

    <ul class="ids" data-reveal style="--dl: 4">
      {
        social.map((c) => (
          <li>
            <a class="btn btn-id" href={c.href} rel="me noopener" target="_blank">
              <Icon name={c.icon} size={Math.round(16 * c.optical)} />
              {c.label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="fine" data-reveal style="--dl: 5">
      <span>{site.location}, {site.timezone}</span>
      <Sep />
      <span>remote worldwide, contractor or through an employer of record</span>
      <Sep />
      <span>English (full professional), Russian</span>
    </p>
  </div>
</section>

<style>
  section {
    position: relative;
    border-top: 1px solid var(--line);
    padding-block: clamp(54px, 6vw, 80px);
  }


  /* On the page's left edge like every section above it. Centred, it read as
     a template's closing banner rather than the end of this page. */
  .inner {
    position: relative;
  }

  h2 {
    margin-bottom: 20px;
    max-width: 900px;
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  /* The one link in the copy, drawn the way the log draws its links: an
     underline a shade quieter than the text, which comes up on hover. It
     was bare, and a bare phrase in a sentence says nothing about being a
     place to go. */
  .lede a {
    color: var(--fg-soft);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.32);
    transition:
      color 0.18s,
      text-decoration-color 0.18s;
  }

  .lede a:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 34px 0 22px;
  }

  .ids {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 26px;
  }

  /* The ASCII globe stands to the right of the copy on a tablet. */
  @media (min-width: 1000px) and (max-width: 1400px) {
    :global(html.ascii-object) .lede {
      max-width: 48ch;
    }
  }

  .fine {
    max-width: 70ch;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    font-size: 13px;
    line-height: 1.7;
    color: var(--fg3);
  }

  /* Narrow, the three facts wrap anyway, and a slash left at the start or the
     end of a line separates nothing: one fact to a line instead. */
  @media (max-width: 560px) {
    .fine {
      display: block;
    }

    .fine > span {
      display: block;
    }

    .fine :global(.sep) {
      display: none;
    }
  }
</style>
