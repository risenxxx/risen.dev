---
import { contacts, site, cvFileName } from '../data/site.ts'
import Icon from './Icon.astro'
import Sep from './Sep.astro'

/* The second ask, and the shortest. The first is a button in the navigation,
   before anybody has a reason to press it; what I am looking for is written out
   in `Now`, near the top, where somebody deciding whether to read on needs it.
   By here the only thing left to say is the address. */
const social = contacts.filter((c) => c.id !== 'email')
---

<section id="contact">
  <div class="wrap inner">
    <p class="pill" data-reveal><span class="live" aria-hidden="true"></span>Available now</p>

    <h2 data-reveal style="--dl: 1">Write to me</h2>

    <p class="lede" data-reveal style="--dl: 2">
      Senior product, full-stack or platform roles, contract work, and one-off architecture reviews.
      The terms are up at <a href="#now">Looking for the next team</a>.
    </p>

    <div class="cta" data-reveal style="--dl: 3">
      <a class="btn btn-primary btn-lg" href={`mailto:${site.email}`}>
        <Icon name="b-mail" />
        {site.email}
      </a>
      <a class="btn btn-ghost btn-lg" href={site.cv} download={cvFileName}>
        <Icon name="u-download" />
        Download CV
      </a>
    </div>

    <ul class="ids" data-reveal style="--dl: 4">
      {
        social.map((c) => (
          <li>
            <a class="btn btn-id" href={c.href} rel="me">
              <Icon name={c.icon} size={Math.round(16 * c.optical)} />
              {c.label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="fine" data-reveal style="--dl: 5">
      {site.location}, {site.timezone}
      <Sep />
      remote worldwide, contractor or EOR
      <Sep />
      English (full professional), Russian
    </p>
  </div>
</section>

<style>
  section {
    position: relative;
    border-top: 1px solid var(--line);
    padding-block: clamp(54px, 6vw, 80px);
  }


  .inner {
    position: relative;
    text-align: center;
  }

  h2 {
    margin: 22px auto 20px;
    max-width: 900px;
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .lede {
    margin-inline: auto;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin: 34px 0 22px;
  }

  .ids {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-bottom: 26px;
  }

  .fine {
    max-width: 70ch;
    margin-inline: auto;
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 13px;
    line-height: 1.7;
    color: var(--fg3);
  }
</style>
