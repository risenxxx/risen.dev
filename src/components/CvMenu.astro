---
import { contactEvent } from '../analytics.ts'
import { resumes } from '../data/site.ts'
import Icon from './Icon.astro'

/*
  The CV button. The label opens the full-stack resume, the one the page's own
  claim is about, in a new tab; the chevron beside it opens a menu of all
  three, one public resume per direction. A reader who wants a CV gets one in
  a click, and the choice is still there for the one who wants the other two.

  The menu is a native popover rather than a script. The browser already does
  everything a menu needs to — open and close on the button, close on Escape
  and on a click anywhere else, sit above every stacking context on the page —
  and anchor positioning keeps it under the pair however the page scrolls.
  Where anchoring is not supported the popover falls back to the centre of the
  viewport, which is still a working menu.

  `id` is only there to give each instance its own anchor name; there is more
  than one of these on the page.
*/
interface Props {
  id: string
  class?: string
  primary?: boolean
  large?: boolean
  iconSize?: number
  align?: 'start' | 'center' | 'end'
}

const { id, class: cls, primary = false, large = false, iconSize, align = 'start' } = Astro.props
const menu = `cv-menu-${id}`
const anchor = `--cv-${id}`
const main = resumes[0]
const look = ['btn', primary ? 'btn-primary' : 'btn-ghost', large && 'btn-lg']
---

<div class:list={['cv-pair', cls]} style={`anchor-name: ${anchor}`}>
  <a
    class:list={[...look, 'cv-main']}
    href={main.href}
    target="_blank"
    rel="noopener"
    {...contactEvent('cv', id)}
    data-rybbit-prop-resume={main.id}
  >View CV</a>
  <button
    type="button"
    class:list={[...look, 'cv-more']}
    popovertarget={menu}
    aria-haspopup="menu"
    aria-label="Other versions of the CV"
  >
    <Icon name="u-chevron-down" size={iconSize} class="chev" />
  </button>
</div>

<div
  id={menu}
  class:list={['cv-menu', align]}
  popover
  role="menu"
  aria-label="Choose a resume"
  style={`position-anchor: ${anchor}`}
>
  {
    resumes.map((r) => (
      <a role="menuitem" href={r.href} target="_blank" rel="noopener" {...contactEvent('cv', id)} data-rybbit-prop-resume={r.id}>
        <span class="label">{r.label}</span>
        <Icon name="u-external" size={14} />
      </a>
    ))
  }
</div>

<script>
  // A link that opens in a new tab leaves this page as it was, menu included.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.cv-menu a')) {
    link.addEventListener('click', () => link.closest<HTMLElement>('[popover]')?.hidePopover())
  }
</script>

<style>
  /* Two buttons drawn as one: they share the hairline between them. */
  .cv-pair {
    display: inline-flex;
  }

  .cv-more {
    margin-left: -1px;
    padding-inline: 11px;
  }

  /* The ghost's hover cursor belongs to the label, not to an arrow. */
  .cv-more::after {
    content: none;
  }

  .cv-more :global(.chev) {
    opacity: 0.6;
    transition: rotate 0.18s var(--ease);
  }

  .cv-pair:has(+ .cv-menu:popover-open) :global(.chev) {
    rotate: 180deg;
  }

  .cv-menu {
    /* The UA sheet centres a popover with `inset: 0; margin: auto`; anchored,
       it is placed by `position-area` instead. */
    inset: auto;
    margin: 8px 0;
    position-area: bottom span-right;
    position-try-fallbacks: flip-block, flip-inline;

    min-width: 230px;
    padding: 6px;
    border: 1px solid var(--line2);
    border-radius: 0;
    background: var(--s3);
    color: var(--fg);

    opacity: 0;
    translate: 0 -4px;
    transition:
      opacity 0.16s,
      translate 0.16s var(--ease),
      overlay 0.16s allow-discrete,
      display 0.16s allow-discrete;
  }

  .cv-menu.center {
    position-area: bottom center;
    position-try-fallbacks: flip-block;
  }

  .cv-menu.end {
    position-area: bottom span-left;
  }

  .cv-menu:popover-open {
    opacity: 1;
    translate: 0 0;
  }

  @starting-style {
    .cv-menu:popover-open {
      opacity: 0;
      translate: 0 -4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cv-menu,
    .cv-more :global(.chev) {
      transition: none;
    }
  }

  .cv-menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 12px;
    border-radius: 0;
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    color: var(--fg);
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .cv-menu a :global(.ic) {
    color: var(--fg3);
    transition: color 0.15s;
  }

  .cv-menu a:hover,
  .cv-menu a:focus-visible {
    background: rgba(255, 255, 255, 0.06);
  }

  .cv-menu a:hover :global(.ic),
  .cv-menu a:focus-visible :global(.ic) {
    color: var(--fg);
  }
</style>
