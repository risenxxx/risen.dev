---
/*
  The reference figure. Not any one product's diagram — the shape every product
  here is cut from, so the hero can say "I design the system" and then show what
  that means before the first product appears.

  Set in the page's own type, not a costume of its own. It used to be all
  monospace, which the rest of the page keeps for strings a machine would parse
  — and most of what is written in here is English. So the labels a machine
  would print (CLIENTS, 01 SPEC) stay monospace, and every sentence is in the
  body face. It also used to be a filled panel, the one card that size on a page
  otherwise divided by hairlines; now the boxes are hairlines too, and the only
  line with a colour in it is the route a request takes.

  Laid out in a 1256 × 510 user-space grid and drawn at `width: 100%` with the
  height left to the aspect ratio, so the figure's own edges land exactly on the
  heading above it at every width. A fixed height would letterbox it inside a
  wider box and pull both edges in.

  Above the figure, as text, the six steps every product goes through on its
  way from a plan to a running service: a list, a step to a line, with the
  number and the step's name in the mono and the rest as a sentence. The
  figure under it is one request at run time. What it runs on and what
  watches it are steps 05 and 06, so the figure does not draw them again.
*/

const steps = [
  {
    n: '01',
    key: 'spec',
    title: 'Acceptance cases first',
    body: 'Written down before implementation starts. It is what a reviewer checks the work against, and what an agent is held to.',
  },
  {
    n: '02',
    key: 'contracts',
    title: 'Types at every seam',
    body: 'One schema serves validation, types and the generated docs, so both sides of a seam can be built in parallel and a broken state is impossible to express.',
  },
  {
    n: '03',
    key: 'ci gates',
    title: 'Tested against the real thing',
    body: 'Unit, integration and contract tests, Testcontainers against real PostgreSQL, Redis and NATS. Security and performance are gates, not follow-ups.',
  },
  {
    n: '04',
    key: 'delivery',
    title: 'GitOps, not hands',
    body: 'FluxCD reconciles the cluster to the repository. Releases and rollbacks are the same operation, and both finish in under three minutes.',
  },
  {
    n: '05',
    key: 'platform',
    title: 'Written down, not clicked',
    body: 'Kubernetes on Talos Linux across bare metal and cloud, described in one Pulumi program that anyone on the team can read and change.',
  },
  {
    n: '06',
    key: 'operation',
    title: 'I hear about it first',
    body: 'Metrics, traces and structured logs on every service, and enough signal to know something is wrong before a user reports it.',
  },
]
---

<section class="arch" id="architecture" data-object="arch">
  <div class="wrap">
    <div data-reveal>
      <div class="head">
        <h2 class="h-section" data-path="~/architecture">How I draw a system before any of it exists</h2>
        <p class="lede">
          Every product below is a subset of this, sized to the problem. Six steps take each one from a plan
          to a running service, whether it ships to a cluster or to an installer.
        </p>
      </div>

      <ol class="rows">
        {
          steps.map((st, i) => (
            <li data-reveal style={`--dl: ${i}`}>
              <p class="key mono">
                <b>{st.n}</b> {st.key}
              </p>
              <p class="txt">
                <strong>{st.title}.</strong> {st.body}
              </p>
            </li>
          ))
        }
      </ol>

      <p class="cap-html mono">runtime/ <span class="dim">one request from edge to storage</span></p>

      <div class="figwrap" data-pan-frame data-offscreen-pause>
        <div class="viewport">
          <div class="scroller" data-pan>
            <svg
            class="fig"
            viewBox="0 0 1256 258"
            data-scene
            data-dur="1600"
            data-ease="linear"
            role="img"
            aria-label="One request at run time: clients through the edge and an API gateway into HTTP services and a real-time layer, through RabbitMQ and NATS, the brokers layer, to workers and durable workflows, then into the OLTP, OLAP and cache tiers."
          >
            <g class="b2">
              <rect x="0.5" y="0.5" width="149" height="256" class="box"></rect>
              <text x="16" y="24" class="lbl">clients</text>
              <g class="val2"><text x="16" y="62">Web and SSR</text><text x="16" y="98">Telegram Mini App</text><text x="16" y="134">Desktop app</text><text x="16" y="170">Bot and CLI</text></g>
              <path class="hair" d="M16 74h118M16 110h118M16 146h118"></path>
              <text x="16" y="210" class="sub">One typed contract</text>
              <text x="16" y="226" class="sub">serves all of them</text>
              <rect x="174.5" y="79.5" width="149" height="98" class="box"></rect>
              <text x="190" y="103" class="lbl">edge</text>
              <text x="190" y="127" class="val2 big">Cloudflare</text>
              <text x="190" y="145" class="sub">WAF, cache, bot rules</text>
              <text x="190" y="161" class="sub">Per-route rate limits</text>
              <rect x="348.5" y="79.5" width="169" height="98" class="box"></rect>
              <text x="364" y="103" class="lbl">api gateway</text>
              <text x="364" y="127" class="val2 big">Typed contracts</text>
              <text x="364" y="145" class="sub">One schema, both sides</text>
              <text x="364" y="161" class="sub">Authn, idempotency keys</text>
              <rect x="542.5" y="20.5" width="197" height="76" class="box"></rect>
              <text x="558" y="44" class="lbl">http services</text>
              <text x="558" y="68" class="val2">Stateless, scaled out</text>
              <rect x="542.5" y="160.5" width="197" height="76" class="box lit"></rect>
              <text x="558" y="184" class="lbl">real-time layer</text>
              <text x="558" y="208" class="val2">WebSockets, reconnect-safe</text>
              <rect x="764.5" y="79.5" width="141" height="98" class="box"></rect>
              <text x="780" y="103" class="lbl">brokers</text>
              <text x="780" y="127" class="val2 big">RabbitMQ, NATS</text>
              <text x="780" y="145" class="sub">Messages between</text>
              <text x="780" y="161" class="sub">services, and jobs</text>
              <rect x="926.5" y="20.5" width="181" height="76" class="box"></rect>
              <text x="942" y="44" class="lbl">workers</text>
              <text x="942" y="68" class="val2">Queues, schedules, ingest</text>
              <rect x="926.5" y="160.5" width="181" height="76" class="box"></rect>
              <text x="942" y="184" class="lbl">workflows</text>
              <text x="942" y="208" class="val2 big">Durable state</text>
              <text x="942" y="226" class="sub">Retry, compensate</text>
              <rect x="1132.5" y="0.5" width="123" height="76" class="box"></rect>
              <text x="1148" y="24" class="lbl">oltp</text>
              <text x="1148" y="48" class="val2">PostgreSQL</text>
              <rect x="1132.5" y="90.5" width="123" height="76" class="box"></rect>
              <text x="1148" y="114" class="lbl">olap</text>
              <text x="1148" y="138" class="val2">ClickHouse</text>
              <rect x="1132.5" y="180.5" width="123" height="76" class="box"></rect>
              <text x="1148" y="204" class="lbl">cache, blob</text>
              <text x="1148" y="228" class="val2">Redis, S3</text>
            </g>

            <!-- The route in six legs, drawn one after another with some overlap:
                 clients to the edge, the edge to the gateway, the fan into the
                 services, the fan into the broker, the fan out of it, the fan
                 into storage. Every branch of a leg is its own subpath from the
                 same start and --len is its longest, so the fronts of a fan
                 move at one speed. -->
            <path class="leg" style="--from: 0.3; --len: 24" d="M150 128.5H174"></path>
            <path class="arrow" style="--from: 0.3" d="M168 124.0l6 4.5-6 4.5"></path>
            <path class="leg" style="--from: 0.39; --len: 24" d="M324 128.5H348"></path>
            <path class="arrow" style="--from: 0.39" d="M342 124.0l6 4.5-6 4.5"></path>
            <path class="leg" style="--from: 0.48; --len: 94" d="M518 128.5h12V58.5H542M518 128.5h12V198.5H542"></path>
            <path class="arrow" style="--from: 0.48" d="M536 54.0l6 4.5-6 4.5M536 194.0l6 4.5-6 4.5"></path>
            <path class="leg" style="--from: 0.57; --len: 94" d="M740 58.5h12V128.5H764M740 198.5h12V128.5H764"></path>
            <path class="arrow" style="--from: 0.57" d="M758 124.0l6 4.5-6 4.5"></path>
            <path class="leg" style="--from: 0.66; --len: 90" d="M906 128.5h8V58.5H926M906 128.5h8V198.5H926"></path>
            <path class="arrow" style="--from: 0.66" d="M920 54.0l6 4.5-6 4.5M920 194.0l6 4.5-6 4.5"></path>
            <path class="leg" style="--from: 0.75; --len: 94" d="M1108 58.5h12V38.5H1132M1108 58.5h12V128.5H1132M1108 198.5h12V218.5H1132M1108 198.5h12V128.5"></path>
            <path class="arrow" style="--from: 0.75" d="M1126 34.0l6 4.5-6 4.5M1126 124.0l6 4.5-6 4.5M1126 214.0l6 4.5-6 4.5"></path>

            <!-- Requests: once the route is drawn, a short pulse runs it from the
                 clients to storage every few seconds, splitting where the route fans
                 out. Each leg is a copy of the route's leg with one short dash on it. -->
            <g class="pulses" aria-hidden="true">
              <path class="pulse p1" d="M150 128.5H174"></path>
              <path class="pulse p2" d="M324 128.5H348"></path>
              <path class="pulse p3" d="M518 128.5h12V58.5H542M518 128.5h12V198.5H542"></path>
              <path class="pulse p4" d="M740 58.5h12V128.5H764M740 198.5h12V128.5H764"></path>
              <path class="pulse p5" d="M906 128.5h8V58.5H926M906 128.5h8V198.5H926"></path>
              <path class="pulse p6" d="M1108 58.5h12V38.5H1132M1108 58.5h12V128.5H1132M1108 198.5h12V218.5H1132M1108 198.5h12V128.5"></path>
            </g>
          </svg>
          </div>
          <span class="edge edge-left" aria-hidden="true"></span>
          <span class="edge edge-right" aria-hidden="true"></span>
        </div>

        <div class="track" aria-hidden="true"><span class="thumb" data-pan-bar></span></div>

        <p class="hint">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 7 4 12l4 5M16 7l4 5-4 5M4.6 12h14.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          Drag the figure sideways to follow the path
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* A section like the ones either side of it: a hairline above, the heading
     on the page's left edge, and nothing drawn around it. */
  .arch {
    border-top: 1px solid var(--line);
    padding-block: clamp(46px, 5vw, 68px);
  }

  .head {
    margin-bottom: clamp(28px, 3vw, 38px);
  }

  .head .lede {
    margin-top: 14px;
  }

  /*
    The six steps: a list, a step to a line. The number and the step's name
    are the mono column on the left, the title and its text one sentence on
    the right. No caption above it — the heading is the caption — so the only
    numbers here are the steps' own. Under the object the list keeps clear of
    the right lane, and the object rides that lane down beside it.
  */
  .rows {
    display: grid;
    gap: 18px;
    margin-bottom: clamp(44px, 4.8vw, 60px);
  }

  .rows li {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 20px;
    align-items: baseline;
  }

  .key {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--fg3);
  }

  .key b {
    font-weight: 500;
    color: var(--amber);
    margin-right: 4px;
  }

  .txt {
    max-width: 70ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg-body);
  }

  .txt strong {
    font-weight: 600;
    color: var(--fg);
  }

  @media (min-width: 1000px) {
    :global(html.ascii-object) .rows {
      width: calc(100% - 300px);
    }
  }

  /* Narrow, the key goes above its sentence. */
  @media (max-width: 640px) {
    .rows li {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }
  }

  .cap-html {
    margin-bottom: 18px;
    font-size: 12.5px;
    color: var(--fg2);
  }

  .cap-html .dim {
    color: var(--fg3);
  }

  /*
    Below roughly a laptop the figure stops being readable when it shrinks, so
    it keeps its size and the reader pans it instead — which only works if the
    page says so. Three things say it: a fade on whichever side still has figure
    under it, a bar showing which slice of the figure is on screen, and a line
    naming the gesture.

    The media query is the guess that works without JavaScript — below this
    width the figure always overflows. Once the script has measured the real
    widths it adds `measured`, and from there the classes it toggles are the
    truth: `pannable` takes all three back off if the figure turned out to fit,
    and `at-start` / `at-end` fade out the edge that has nothing under it.
  */
  .viewport {
    position: relative;
  }

  .scroller {
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  /*
    One bar under the figure, never two. Without JavaScript the browser's own
    scrollbar is the only one that tracks anything, so it stays. Once the script
    has measured, the thin bar below takes over — it is the page's style, and it
    is the one the fades and the hint are kept in step with — and the native one
    goes, or the two sit one above the other.
  */
  .figwrap.measured .scroller {
    scrollbar-width: none;
  }

  .figwrap.measured .scroller::-webkit-scrollbar {
    display: none;
  }

  /* A mouse has no swipe, so the script makes the figure draggable and the
     cursor is how that is offered. Only once there is somewhere to drag it. */
  .figwrap.pannable .scroller {
    cursor: grab;
  }

  .figwrap.dragging .scroller {
    cursor: grabbing;
    user-select: none;
  }

  .edge,
  .track,
  .hint {
    display: none;
  }

  @media (max-width: 1250px) {
    .edge {
      display: block;
    }

    .figwrap.measured .track {
      display: block;
    }

    .hint {
      display: flex;
    }
  }

  .figwrap.measured:not(.pannable) .edge,
  .figwrap.measured:not(.pannable) .track,
  .figwrap.measured:not(.pannable) .hint {
    display: none;
  }

  .edge {
    position: absolute;
    inset: 0 auto 0 0;
    width: 64px;
    pointer-events: none;
    transition: opacity 0.24s ease;
  }

  /* The figure starts unscrolled, so the right edge is the one covering
     something and the left is the one that has to earn its way in. */
  .edge-left {
    background: linear-gradient(to left, transparent, var(--bg));
    opacity: 0;
  }

  .edge-right {
    inset: 0 0 0 auto;
    background: linear-gradient(to right, transparent, var(--bg));
  }

  .figwrap.measured:not(.at-start) .edge-left {
    opacity: 1;
  }

  .figwrap.measured.at-end .edge-right {
    opacity: 0;
  }

  .track {
    position: relative;
    height: 3px;
    margin-top: 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
  }

  /* Only drawn once the script has measured, so it always has a real width and
     position; the fallbacks are just what it holds for the frame before. */
  .thumb {
    position: absolute;
    inset: 0 auto;
    left: var(--x, 0%);
    width: var(--w, 100%);
    border-radius: inherit;
    background: rgba(255, 255, 255, 0.32);
  }

  .hint {
    align-items: center;
    gap: 9px;
    margin-top: 12px;
    font-size: 13px;
    color: var(--fg3);
    transition: opacity 0.3s ease;
  }

  /* An instruction is read the moment it is obeyed. */
  .figwrap.panned .hint {
    opacity: 0;
  }

  .hint svg {
    width: 15px;
    height: 15px;
    flex: none;
  }

  /* Never below nine tenths of its drawn size, about 232 px tall: the labels
     stay letters. Narrower than that the figure pans instead of shrinking. */
  .fig {
    width: 100%;
    min-width: 1130px;
    height: auto;
    font-family: var(--mono);
  }

  /* Outlines, not cards: nothing in here is filled, the way nothing else on
     the page is. */
  .box {
    fill: none;
    rx: 0;
    ry: 0;
    stroke: rgba(255, 255, 255, 0.1);
  }

  /* With the ASCII object behind the figure, the boxes take
     the page's surface so they sit in front of it the way the cards do,
     while the lines between them stay open. */
  :global(html.ascii-object) .box {
    fill: var(--bg);
  }

  /* The one long heading on the page breaks into two lines beside the
     object, which gives the object the height of both. */
  @media (min-width: 1000px) and (max-width: 1400px) {
    :global(html.ascii-object) h2 {
      max-width: 13em;
    }
  }

  /* The real-time layer is the one box the route passes through that no other
     box stands in for, so it is the one that takes the route's colour. */
  .box.lit {
    stroke: var(--route);
    stroke-opacity: 0.5;
  }

  .hair {
    stroke: rgba(255, 255, 255, 0.08);
    fill: none;
  }

  .lbl {
    font-size: 10px;
    fill: var(--fg3);
    letter-spacing: 0;
    text-transform: lowercase;
  }

  /*
    Everything below is a sentence or a name, so it is the body face. Each is a
    step up on the size it had in monospace, which set wider and so read larger
    at the same number.
  */
  .val2,
  .sub {
    font-family: var(--sans);
  }

  .val2 {
    font-size: 12.5px;
    fill: var(--fg-mid);
  }

  .val2.big {
    font-size: 14px;
    fill: var(--fg);
  }

  .sub {
    font-size: 11.5px;
    fill: var(--fg-body);
  }

  /*
    The boxes arrive, then the route draws itself along them, a leg
    at a time, and each leg's arrowheads land as its line reaches them.

    `--p` is plain time here (`data-ease="linear"`) and every beat eases
    itself. The route used to be one path with one dash as long as all of it,
    walked from start to end — but a dash pattern restarts at every subpath,
    and every leg is its own subpath a few dozen units long, so each one was
    fully drawn the moment the offset moved at all. On a reload with the figure
    in view that read as the lines blinking on while the heads faded in.
  */
  .b2 {
    --t: clamp(0, var(--p) / 0.22, 1);
    opacity: calc(1 - (1 - var(--t)) * (1 - var(--t)) * (1 - var(--t)));
  }

  /* Each leg draws over 16% of the scene, about a quarter of a second, on a
     smoothstep: slow off the mark, slow into the box. Its dash is its own
     longest branch, so offset 0 is fully drawn and --len is nothing at all.
     The opacity guard keeps a round cap from leaving a dot at the start of a
     leg that has not begun yet. */
  .leg {
    --t: clamp(0, (var(--p) - var(--from)) / 0.16, 1);
    --d: calc(var(--t) * var(--t) * (3 - 2 * var(--t)));
    fill: none;
    stroke: var(--route);
    stroke-opacity: 0.75;
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: var(--len);
    stroke-dashoffset: calc(var(--len) * (1 - var(--d)));
    opacity: clamp(0, var(--t) * 1000, 1);
  }

  .arrow {
    fill: none;
    stroke: var(--route);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: clamp(0, (var(--p) - var(--from) - 0.13) / 0.06, 1);
  }


  /*
    The pulses. One cycle is 2.6 s: the first 1.6 s of it carries a pulse from
    the clients to storage, each leg taking a share of that time in
    proportion to its length so the pulse keeps one speed, and the rest is a
    pause before the next request. They come in only once the route has
    finished drawing, and not at all under reduced motion.
  */
  .pulses {
    opacity: clamp(0, (var(--p) - 0.94) * 16, 1);
  }

  .pulse {
    fill: none;
    stroke: var(--btn-hover);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 22 2000;
    stroke-dashoffset: 24;
    filter: drop-shadow(0 0 4px var(--route));
    animation-duration: 2.6s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .p1 {
    animation-name: pulse-1;
  }

  .p2 {
    animation-name: pulse-2;
  }

  .p3 {
    animation-name: pulse-3;
  }

  .p4 {
    animation-name: pulse-4;
  }

  .p5 {
    animation-name: pulse-5;
  }

  .p6 {
    animation-name: pulse-6;
  }

  @keyframes pulse-1 {
    0%,
    0.00% {
      stroke-dashoffset: 24;
    }
    3.48%,
    100% {
      stroke-dashoffset: -27;
    }
  }
  @keyframes pulse-2 {
    0%,
    3.48% {
      stroke-dashoffset: 24;
    }
    6.97%,
    100% {
      stroke-dashoffset: -27;
    }
  }
  @keyframes pulse-3 {
    0%,
    6.97% {
      stroke-dashoffset: 24;
    }
    20.61%,
    100% {
      stroke-dashoffset: -97;
    }
  }
  @keyframes pulse-4 {
    0%,
    20.61% {
      stroke-dashoffset: 24;
    }
    34.25%,
    100% {
      stroke-dashoffset: -97;
    }
  }
  @keyframes pulse-5 {
    0%,
    34.25% {
      stroke-dashoffset: 24;
    }
    47.90%,
    100% {
      stroke-dashoffset: -97;
    }
  }
  @keyframes pulse-6 {
    0%,
    47.90% {
      stroke-dashoffset: 24;
    }
    61.54%,
    100% {
      stroke-dashoffset: -97;
    }
  }

  /* Off screen they stop: an endless dash animation repaints the figure
     every frame wherever the reader is (motion.ts sets the class). */
  .figwrap:global(.paused) .pulse {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .pulses {
      display: none;
    }
  }
</style>
