---
import FramePlayerMock from './mocks/FramePlayer.astro'
import GiftFightMock from './mocks/GiftFight.astro'
import TolklyMock from './mocks/Tolkly.astro'
import TunedMock from './mocks/Tuned.astro'
import Project from './Project.astro'
import Stage from './Stage.astro'

/*
  DeskVolt is off the page, not deleted: it is the slightest of the five and it
  was buying the least attention per screen of it. Its block and its preview
  import are commented below rather than removed, because the product is still
  shipped and still linked from the log — this is an editing decision about the
  page, and the day it stops being one the two comments come out again.

  dubsync went the same way when Tolkly came in at the top, for the same
  reason: four products are as many screens as the section should ask a
  reader to scroll through, and dubsync is the one of them furthest from the
  work the page is looking for. The log still links it, and its block, its
  preview and its place in the ASCII layer (src/ascii/sections.ts, `dub`) all
  stay where they are; bringing it back is uncommenting the block and the
  import below.

  The rows alternate, preview on the left then on the right: Tolkly, Frame
  Player, Tuned, Gift Fight. The side decides where the ASCII object can live
  (src/ascii/sections.ts): with the copy on the right it rides a column down
  the copy's right edge, as in Tolkly and Tuned; with the copy on the left the
  preview has the right edge, and the object hangs under it, as in Frame
  Player, or, beside a preview as narrow as Gift Fight's phone, rides the
  strip it leaves. A row that changes side changes its place there too.
  dubsync, if it comes back after Gift Fight, comes back with its preview on
  the left, and so with a column rather than the hung place it has now.
*/
// import DubsyncMock from './mocks/Dubsync.astro'
---

<section id="work">
  <div class="wrap intro">
    <h2 class="h-section" data-path="~/work" data-reveal>Selected work</h2>
    <p class="lede">
      Each taken from a blank plan to production, with a link to the source wherever the source is public.
    </p>
  </div>

  <Project
    accent="#239d6a"
    object="tolkly"
    title="Tolkly"
    meta={['Customer support', 'Chat widget']}
    blurb="A support chat for websites where an AI answers first, from the site’s own rules, and never makes an answer up."
    bullets={[
      'Every answer links to the page it came from and quotes the line behind it. On twenty questions about GrowthBook’s docs it got all 15 they cover right and declined all 5 they do not.',
      'What the rules do not cover goes to a person, in the inbox or the team’s Telegram, with the order number already attached.',
      'Takes the site’s colours, font and corners by itself. Two lines to install, and the chat loads only when opened.',
    ]}
    stack={[
      { label: 'TypeScript' },
      { label: 'Bun' },
      { label: 'PostgreSQL + pgvector' },
      { label: 'React 19' },
      { label: 'oRPC' },
      { label: 'Web Components' },
    ]}
    links={[{ label: 'Website', href: 'https://tolkly.io', icon: 'u-external' }]}
  >
    <Stage bare h={700}><TolklyMock /></Stage>
  </Project>

  <Project
    accent="#818cf8"
    object="frame"
    title="Frame Player"
    meta={['Media playback', 'Windows and macOS']}
    blurb="A video player that sends a 4K HDR film to the television exactly as it is, with no loss of quality, while the app on the computer stays a working remote. Torrents play while they are still downloading."
    bullets={[
      'One interface for Windows and macOS, drawn as a web page over a native video engine. On macOS the engine (libmpv) could not sit inside another window at all, so I patched it.',
      'Hovering the timeline shows the exact frame under the cursor. The usual shortcut showed the wrong scene 60% of the time; the player now measures each file and gets it right.',
    ]}
    metrics={[
      { value: '2 platforms', note: 'signed, updates itself' },
      { value: '0 re-encodes', note: 'the television gets the original' },
      {
        value:
          '60% <svg class="ic arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m0 0-5-5m5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg> 0',
        note: 'previews showing the wrong frame',
      },
    ]}
    stack={[
      { label: 'Rust' },
      { label: 'Tauri 2' },
      { label: 'Svelte 5' },
      { label: 'TypeScript' },
      { label: 'FFmpeg' },
      { label: 'libmpv' },
      { label: 'Chromecast / DLNA' },
    ]}
    links={[
      { label: 'Website', href: 'https://frameplayer.app', icon: 'u-external' },
      { label: 'Codebase', href: 'https://github.com/risenxxx/frame-player', icon: 'b-github' },
      { label: 'Write-up (RU)', href: 'https://habr.com/ru/articles/1089272/', icon: 'u-external' },
      {
        label: 'Download latest release',
        href: 'https://github.com/risenxxx/frame-player/releases/latest',
        icon: 'u-download',
      },
    ]}
    reverse
  >
    <Stage bare><FramePlayerMock /></Stage>
  </Project>

  <Project
    accent="#7c8cff"
    object="tuned"
    title="Tuned"
    meta={['Document tooling', 'Hosted SaaS']}
    blurb="Tailors a resume to every job posting without losing the original: each version is a set of changes over one base resume, so a hundred applications never drift apart. Live with payments five weeks after the first commit."
    bullets={[
      'The AI can reword but cannot invent: a claim that does not trace back to the base resume is refused.',
      'The preview is drawn by the same PDF renderer as the download, so a page that fits on screen fits in the file, measured rather than estimated.',
    ]}
    stack={[
      { label: 'TypeScript' },
      { label: 'React 19' },
      { label: 'pdf.js' },
      { label: 'Bun' },
      { label: 'Elysia' },
      { label: 'oRPC' },
      { label: 'PostgreSQL' },
      { label: 'Drizzle' },
      { label: 'BullMQ' },
      { label: 'Kubernetes' },
    ]}
    links={[{ label: 'Website', href: 'https://tunedhq.io', icon: 'u-external' }]}
  >
    <Stage bare h={532}><TunedMock /></Stage>
  </Project>

  <Project
    accent="#a8ff35"
    object="gift"
    title="Gift Fight"
    meta={['Real-time multiplayer', 'Telegram Mini App']}
    blurb="A real-time game inside Telegram where players bet collectible gifts against each other, and anyone who played a round can check afterwards that it was fair. Designed, built and run in production end to end."
    bullets={[
      'No game is lost mid-round: a round in progress survives a server restart or a new release (Temporal).',
      'Play is live, and crypto payments run through separate services that never settle the same bet twice.',
      'Every game event reaches the analytics once, with no gaps or duplicates, even after a failure (Kafka into ClickHouse).',
    ]}
    metrics={[
      { value: '120 ms', note: 'to reach players, 300 at once' },
      { value: 'every round', note: 'survives a release' },
      { value: '~1,500', note: 'players at launch' },
    ]}
    note="Closed in 2025 on purpose: the data showed free channels bringing players who did not pay, so it was shut down rather than kept going. The code and the cluster are still the work."
    stack={[
      { label: 'TypeScript' },
      { label: 'React' },
      { label: 'Hono' },
      { label: 'PostgreSQL' },
      { label: 'Temporal' },
      { label: 'Kafka (Redpanda)' },
      { label: 'Socket.IO' },
      { label: 'Kubernetes' },
      { label: 'Pulumi' },
    ]}
    links={[
      { label: 'Codebase', href: 'https://github.com/gift-fight/gift-fight', icon: 'b-github' },
      { label: 'Infrastructure', href: 'https://github.com/gift-fight/gift-fight-infra', icon: 'b-github' },
    ]}
    reverse
  >
    <Stage bare w={700} h={776}>
      <GiftFightMock />
    </Stage>
  </Project>

  {
    /* Hidden, see the note above. Uncomment this and the DubsyncMock import to bring it back.

  <Project
    accent="#a855f7"
    object="dub"
    title="dubsync"
    meta={['Audio DSP', 'Desktop, CLI and headless']}
    blurb="The 4K release ships only the original audio, and the dub you want exists on an old rip that is cut and timed differently. dubsync finds the offset by itself and produces one file with both."
    bullets={[
      'The soundtracks are correlated with GCC-PHAT and every result carries a peak-to-sidelobe score, so a bad match is <em>reported</em> rather than silently shipped.',
      'Differently cut releases are aligned segment by segment to about 50 ms, frame rates normalised, audio time-stretched instead of clipped, subtitles shifted to match.',
      'The shared anchor track is correlated once into a piecewise offset map that every selected dub reuses, and each splice is snapped to a moment the master is silent, so the cut hides behind a quiet scene change.',
    ]}
    metrics={[
      { value: '±50 ms', note: 'per-segment alignment' },
      { value: 'scored', note: 'every result, never guessed' },
      { value: '3 modes', note: 'GUI, CLI, headless' },
      { value: '1 pass', note: 'one correlation serves every dub' },
    ]}
    stack={[
      { label: 'Rust' },
      { label: 'FFmpeg' },
      { label: 'egui' },
      { label: 'FFT / GCC-PHAT' },
      { label: 'Matroska' },
    ]}
    links={[
      { label: 'Codebase', href: 'https://github.com/risenxxx/dubsync', icon: 'b-github' },
      {
        label: 'Download latest release',
        href: 'https://github.com/risenxxx/dubsync/releases/latest',
        icon: 'u-download',
      },
    ]}
    reverse
  >
    <Stage bare><DubsyncMock /></Stage>
  </Project>
    */
  }


  {
    /* Hidden, see the note above. Uncomment this and the DeskVoltMock import to bring it back.

  <Project
    accent="#ffd400"
    title="DeskVolt"
    meta={['Device monitoring', 'Windows desktop']}
    blurb="Battery levels for wireless peripherals read straight from the devices, with none of the vendor software running in the background to get them."
    bullets={[
      'Logitech HID++ 2.0, SteelSeries, Corsair, HyperX and PlayStation DualSense are each queried directly over USB HID, from protocols reverse-engineered rather than published.',
      'Native Win32 rendering through windows-rs: Direct2D and DirectWrite, LTO-optimised, under 10 MB resident.',
      'Every peripheral sits behind the same trait, so adding one is a single driver module and nothing else.',
    ]}
    metrics={[
      { value: '6 vendors', note: 'none of whom document this' },
      { value: '&lt; 10 MB', note: 'resident memory' },
      { value: '0 services', note: 'no vendor suite required' },
    ]}
    stack={[
      { label: 'Rust' },
      { label: 'windows-rs' },
      { label: 'Direct2D' },
      { label: 'DirectWrite' },
      { label: 'hidapi' },
    ]}
    links={[
      { label: 'Codebase', href: 'https://github.com/risenxxx/DeskVolt', icon: 'b-github' },
      {
        label: 'Download latest release',
        href: 'https://github.com/risenxxx/DeskVolt/releases/latest',
        icon: 'u-download',
      },
    ]}
  >
    <Stage bare><DeskVoltMock /></Stage>
  </Project>
    */
  }
</section>

<style>
  /* The figure above used to be a card, which divided itself from this; now it
     is a section on the page like the rest, so the rule between them is drawn
     here the way every other section draws its own. */
  #work {
    border-top: 1px solid var(--line);
  }

  .intro {
    padding: clamp(46px, 5.4vw, 70px) var(--gut) clamp(24px, 3vw, 34px);
  }

  h2 {
    margin-bottom: 12px;
  }

  .lede {
  }

  /* The arrow inside a metric ("60% → 0") is an icon, not a character: a glyph
     from the body font would be a different weight from the figures around it. */
  :global(.metrics .arrow) {
    width: 15px;
    height: 15px;
    color: var(--fg3);
  }
</style>
