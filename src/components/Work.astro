---
import DeskVoltMock from './mocks/DeskVolt.astro'
import DubsyncMock from './mocks/Dubsync.astro'
import FramePlayerMock from './mocks/FramePlayer.astro'
import GiftFightMock from './mocks/GiftFight.astro'
import TunedMock from './mocks/Tuned.astro'
import Project from './Project.astro'
import Scene from './mocks/Scene.astro'
import Stage from './Stage.astro'
---

<Scene defs />

<section id="work">
  <div class="wrap intro">
    <h2 class="h-section" data-reveal>Selected work</h2>
    <p class="lede">
      Five products taken from a blank plan to production. Permissive licences, written documentation, real users, and a
      link to the source of every one that has public source.
    </p>
  </div>

  <Project
    accent="#818cf8"
    title="Frame Player"
    meta={['Media playback', 'Windows and macOS']}
    blurb="Casts a 4K HDR file to a television exactly as it is: no re-encode, no quality loss, and the app window stays a working remote. Torrents play while they are still downloading."
    bullets={[
      'mpv renders into a native child view <em>behind</em> a transparent webview, the whole UI composited on top as HTML. On macOS that meant patching libmpv, whose backend has no window-embedding support at all.',
      'Piece priority follows the playhead, the seekbar shades what has already arrived, and the next episode is prefetched.',
      'Hover previews sharpen to the exact frame under the cursor. Naive keyframe mapping showed the wrong scene 60% of the time, so the cost of an exact seek is probed per file.',
    ]}
    metrics={[
      { value: '2 platforms', note: 'signed, auto-updated by CI' },
      { value: '0 re-encodes', note: 'on a 4K HDR cast' },
      {
        value:
          '60% <svg class="ic arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m0 0-5-5m5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg> 0',
        note: 'wrong-frame previews',
      },
    ]}
    stack={[
      { label: 'Rust', icon: 'b-rust' },
      { label: 'Tauri 2', icon: 'b-tauri' },
      { label: 'Svelte 5', icon: 'b-svelte' },
      { label: 'TypeScript', icon: 'b-typescript' },
      { label: 'FFmpeg', icon: 'b-ffmpeg' },
      { label: 'libmpv' },
      { label: 'Chromecast / DLNA' },
    ]}
    links={[
      { label: 'Repository', href: 'https://github.com/risenxxx/frame-player', icon: 'b-github' },
      {
        label: 'Download latest release',
        href: 'https://github.com/risenxxx/frame-player/releases/latest',
        icon: 'u-download',
        primary: true,
      },
    ]}
  >
    <Stage bare><FramePlayerMock /></Stage>
  </Project>

  <Project
    accent="#a8ff35"
    title="Gift Fight"
    meta={['Real-time iGaming', 'Telegram Mini App']}
    blurb="A PvP roulette where players bet collectible Telegram gifts against each other, and every round can be recomputed afterwards by anyone who played it. Architected, built and operated end to end."
    bullets={[
      "A round in progress lives in a Temporal workflow rather than in a server's memory, so a restart or a release never drops it.",
      'Live play runs over Socket.IO beside ordinary HTTP, with blockchain payments isolated behind transfer services and idempotent settlement.',
      'Talos Linux and Kubernetes across bare metal and cloud, described in Pulumi, delivered by FluxCD, with secrets that never touch the repository.',
    ]}
    metrics={[
      { value: '120 ms', note: 'p95 state sync, 300 sessions' },
      { value: '99.5%', note: 'workflow completion' },
      { value: '&lt; 3 min', note: 'release and rollback' },
      { value: '~1,500', note: 'players at launch' },
    ]}
    note="Shut down in 2025, on purpose: the funnel showed free channels bringing non-paying users, so the product was closed on the data rather than carried on. The cluster and the code are still the work."
    stack={[
      { label: 'TypeScript', icon: 'b-typescript' },
      { label: 'React', icon: 'b-react' },
      { label: 'Hono', icon: 'b-hono' },
      { label: 'PostgreSQL', icon: 'b-postgresql' },
      { label: 'Temporal', icon: 'b-temporal' },
      { label: 'Socket.IO', icon: 'b-socketdotio' },
      { label: 'Kubernetes', icon: 'b-kubernetes' },
      { label: 'Pulumi', icon: 'b-pulumi' },
    ]}
    links={[
      { label: 'Codebase', href: 'https://github.com/gift-fight/gift-fight', icon: 'b-github' },
      { label: 'Infrastructure', href: 'https://github.com/gift-fight/gift-fight-infra', icon: 'b-github' },
    ]}
    reverse
  >
    <Stage bare w={700} h={776}>
      <GiftFightMock />
    </Stage>
  </Project>

  <Project
    accent="#7c8cff"
    title="Tuned"
    meta={['Document tooling', 'Hosted SaaS']}
    blurb="Resume tailoring where every variant is a patch over one base document rather than a copy, so a hundred applications stay one source of truth, and nothing silently drifts."
    bullets={[
      "A provenance check refuses any claim that doesn't trace back to a source node, so the model can rewrite but cannot invent.",
      'The live preview renders the same react-pdf component inside a Web Worker and rasterises it with pdf.js, so page fitting is measured against a real renderer instead of estimated.',
      'Anthropic and OpenAI-compatible adapters sit behind a single port; the editor has its own drag-and-drop engine.',
    ]}
    stack={[
      { label: 'React 19', icon: 'b-react' },
      { label: 'Bun', icon: 'b-bun' },
      { label: 'Hono', icon: 'b-hono' },
      { label: 'Tailwind v4', icon: 'b-tailwindcss' },
      { label: 'Astro', icon: 'b-astro' },
      { label: 'TanStack' },
      { label: 'pdf.js' },
    ]}
    links={[{ label: 'Visit tunedhq.io', href: 'https://tunedhq.io', icon: 'u-external', primary: true }]}
  >
    <Stage bare h={532}><TunedMock /></Stage>
  </Project>

  <Project
    accent="#a855f7"
    title="dubsync"
    meta={['Audio DSP', 'Desktop, CLI and headless']}
    blurb="The 4K release ships only the original audio, and the dub you want exists on an old rip that is cut and timed differently. dubsync finds the offset by itself and produces one file with both."
    bullets={[
      'The soundtracks are correlated with GCC-PHAT and every result carries a peak-to-sidelobe score, so a bad match is <em>reported</em> rather than silently shipped.',
      'Differently cut releases are aligned segment by segment to about 50 ms, frame rates normalised, audio time-stretched instead of clipped, subtitles shifted to match.',
      'Correlation is parallelised across cores; the same engine runs from a GUI, a CLI or a CI job on Windows, macOS and Linux.',
    ]}
    metrics={[
      { value: '±50 ms', note: 'per-segment alignment' },
      { value: 'scored', note: 'every result, never guessed' },
      { value: '3 modes', note: 'GUI, CLI, headless' },
    ]}
    stack={[
      { label: 'Rust', icon: 'b-rust' },
      { label: 'FFmpeg', icon: 'b-ffmpeg' },
      { label: 'egui' },
      { label: 'FFT / GCC-PHAT' },
      { label: 'Matroska' },
    ]}
    links={[
      { label: 'Repository', href: 'https://github.com/risenxxx/dubsync', icon: 'b-github' },
      {
        label: 'Download latest release',
        href: 'https://github.com/risenxxx/dubsync/releases/latest',
        icon: 'u-download',
        primary: true,
      },
    ]}
    reverse
  >
    <Stage bare><DubsyncMock /></Stage>
  </Project>

  <Project
    accent="#ffd400"
    title="DeskVolt"
    meta={['Device monitoring', 'Windows desktop']}
    blurb="Battery levels for wireless peripherals read straight from the devices, with none of the vendor software running in the background to get them."
    bullets={[
      'Logitech HID++ 2.0, SteelSeries, Corsair, HyperX and PlayStation DualSense are each queried directly over USB HID, from protocols reverse-engineered rather than published.',
      'Native Win32 rendering through windows-rs: Direct2D and DirectWrite, LTO-optimised, under 10 MB resident.',
      'Every peripheral sits behind the same trait, so adding one is a single driver module and nothing else.',
    ]}
    metrics={[
      { value: '6 vendors', note: 'none of whom document this' },
      { value: '&lt; 10 MB', note: 'resident memory' },
      { value: '0 services', note: 'no vendor suite required' },
    ]}
    stack={[
      { label: 'Rust', icon: 'b-rust' },
      { label: 'windows-rs' },
      { label: 'Direct2D' },
      { label: 'DirectWrite' },
      { label: 'hidapi' },
    ]}
    links={[
      { label: 'Repository', href: 'https://github.com/risenxxx/DeskVolt', icon: 'b-github' },
      {
        label: 'Download latest release',
        href: 'https://github.com/risenxxx/DeskVolt/releases/latest',
        icon: 'u-download',
        primary: true,
      },
    ]}
  >
    <Stage bare><DeskVoltMock /></Stage>
  </Project>
</section>

<style>
  .intro {
    padding: clamp(46px, 5.4vw, 70px) var(--gut) clamp(24px, 3vw, 34px);
  }

  h2 {
    margin-bottom: 12px;
  }

  .lede {
  }

  /* The arrow inside a metric ("60% → 0") is an icon, not a character: a glyph
     from the body font would be a different weight from the figures around it. */
  :global(.metrics .arrow) {
    width: 15px;
    height: 15px;
    color: var(--fg3);
  }
</style>
