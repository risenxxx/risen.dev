---

/** Tools shipped and operated, not read about. Libraries and techniques a
    product's own line already names stay with that product; this is the list
    a reader scans for the names they hire for. */
const groups = [
  {
    title: 'Frontend',
    items: [
      { label: 'TypeScript' },
      { label: 'React' },
      { label: 'Next.js' },
      { label: 'Svelte 5' },
      { label: 'Astro' },
      { label: 'Tailwind' },
      { label: 'Effector' },
      { label: 'TanStack' },
      { label: 'Core Web Vitals' },
      { label: 'WCAG' },
      { label: 'Design systems' },
    ],
  },
  {
    title: 'Backend & data',
    items: [
      { label: '.NET 9' },
      { label: 'Node.js' },
      { label: 'Bun' },
      { label: 'Hono' },
      { label: 'Elysia' },
      { label: 'PostgreSQL' },
      { label: 'ClickHouse' },
      { label: 'Redis' },
      { label: 'NATS' },
      { label: 'RabbitMQ' },
      { label: 'Kafka / Redpanda' },
      { label: 'Temporal' },
      { label: 'EF Core' },
      { label: 'OpenAPI' },
    ],
  },
  {
    title: 'Platform & ops',
    items: [
      { label: 'Kubernetes' },
      { label: 'Talos Linux' },
      { label: 'Docker' },
      { label: 'Pulumi' },
      { label: 'Terraform' },
      { label: 'Ansible' },
      { label: 'FluxCD' },
      { label: 'Cloudflare' },
      { label: 'Hetzner' },
      { label: 'DigitalOcean' },
      { label: 'GCP' },
      { label: 'Prometheus' },
      { label: 'Grafana' },
      { label: 'Sentry' },
      { label: 'Actions' },
    ],
  },
  {
    title: 'Further afield',
    items: [
      { label: 'Rust' },
      { label: 'Tauri 2' },
      { label: 'FFmpeg' },
      { label: 'WebAssembly' },
      { label: 'Win32 / Direct2D' },
      { label: 'USB HID' },
      { label: 'libmpv' },
      { label: 'Audio DSP / FFT' },
      { label: 'HDR / Dolby Vision' },
      { label: 'Applied cryptography' },
      { label: 'Telegram Mini Apps' },
    ],
  },
]
---

<section id="stack" data-object="stack">
  <div class="wrap">
    <h2 class="h-section" data-path="~/stack" data-reveal>Shipped and operated</h2>
    <p class="lede">
      Tools I have run in production, not ones I have read about.<br class="br-wide" /> Chosen per
      constraint rather than per fashion.
    </p>

    <!--
      One list of lists, drawn two ways. On a desktop it is `ls -1 stack/*`:
      four columns, a directory each, a tool a line. Narrower it is `tree
      stack/`, with the trunk and its branches drawn as hairlines rather than
      typed — the page's mono has no box-drawing characters, and the ASCII
      `|--` and `` `-- `` stand-ins read as noise — and the tools wrapped a few
      to a line beside the trunk. Either way a reader without eyes gets the
      groups, not the lines.
    -->
    <p class="cmd cmd-tree mono" aria-hidden="true">$ tree stack/</p>
    <p class="cmd cmd-cols mono" aria-hidden="true">$ ls -1 stack/*</p>
    <ul class="groups mono" data-reveal style="--dl: 1">
      {
        groups.map((g, gi) => (
          <li class:list={['group', { last: gi === groups.length - 1 }]}>
            <h3>{g.title.toLowerCase().replace(/ & /g, '-and-').replace(/\s+/g, '-')}/</h3>
            <ul class="items">
              {g.items.map((item) => (
                <li class="chip chip-lg">{item.label}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
section[id] {
    border-top: 1px solid var(--line);
    padding-block: clamp(44px, 5vw, 62px);
  }

  h2 {
    margin-bottom: 10px;
  }

  .lede {
    margin-bottom: 30px;
  }

  /* The command is read, so it takes the floor for text, not the
     decoration grey the tree's branches are drawn in. */
  .cmd {
    font-size: 12.5px;
    color: var(--fg3);
    margin-bottom: 10px;
  }

  .cmd-cols {
    display: none;
  }

  .groups,
  .items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .groups {
    font-size: 13px;
    line-height: 1.9;
    max-width: 820px;
  }

  /*
    The tree's lines are dashed hairlines, not characters. Each directory owns the
    stretch of trunk beside it, from its top down through the gap to the
    next, and a tick out to its name; the last one's trunk stops at its tick,
    which turns it into the elbow `tree` ends on. The name and its tools
    share one indent.
  */
  /* flow-root keeps the list's bottom margin inside the group, so the
     trunk beside it reaches the next directory without a break. */
  .group {
    position: relative;
    display: flow-root;
    padding-left: 3ch;
  }

  .group + .group {
    margin-top: 10px;
  }

  .group::before,
  .group::after {
    content: "";
    position: absolute;
    left: 0.5ch;
  }

  /*
    The trunk is dashed, drawn as a gradient so the dashes are the same
    length on every screen rather than whatever a dashed border picks. Each
    directory draws the stretch from its own tick down to the next one's, and
    the tile is a half dash, a gap and a half dash, repeated with `round` so
    a whole number of tiles fits the stretch exactly. Every stretch therefore
    starts and ends on a half dash, and every joint — the branches and the
    final elbow — meets the trunk the same way: dash, tick, dash. The first
    directory adds the half dash above its tick that it has no stretch for.
    Each tick is a single dash; the tick's centre is 11.75 px down.
  */
  .group::before {
    top: 11.75px;
    bottom: -21.75px;
    width: 1.5px;
    background: linear-gradient(
        to bottom,
        var(--fg4) 0 4.5px,
        transparent 4.5px 9.5px,
        var(--fg4) 9.5px 14px
      )
      0 0 / 100% 14px repeat round;
  }

  .group::after {
    top: 11px;
    width: 13px;
    height: 1.5px;
    background: var(--fg4);
  }

  .last::before {
    content: none;
  }

  .group:first-child h3::before {
    content: "";
    position: absolute;
    top: 7.25px;
    left: 0.5ch;
    width: 1.5px;
    height: 4.5px;
    background: var(--fg4);
  }

  h3 {
    font-family: var(--mono);
    font-size: 13.5px;
    font-weight: 600;
    line-height: 24px;
    color: var(--fg);
  }

  /* The tools, a few to a line, under their directory. Rows have no gap
     between them so the list keeps the listing's line height. */
  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2ch;
    margin: 4px 0 14px;
    padding: 0;
    color: var(--fg-body);
  }

  .items :global(.chip::after) {
    content: none;
    margin: 0;
  }

  /* On a tablet the listing keeps two thirds of the width and the object
     rides the right third. */
  @media (min-width: 1000px) and (max-width: 1400px) {
    :global(html.ascii-object) .groups,
    :global(html.ascii-object) .lede {
      max-width: calc(100% - 272px);
    }
  }

  /* A desktop lists the directories side by side, a tool a line. */
  @media (min-width: 1401px) {
    .cmd-tree {
      display: none;
    }

    .cmd-cols {
      display: block;
    }

    .groups {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 28px;
      max-width: none;
    }

    :global(html.ascii-object) .groups {
      width: calc(100% - 300px);
    }

    .group {
      padding-left: 0;
    }

    .group + .group {
      margin-top: 0;
    }

    .group::before,
    .group::after,
    .group:first-child h3::before {
      content: none;
    }

    .items {
      display: grid;
      gap: 0;
      margin: 16px 0 0;
    }
  }

  @media (max-width: 620px) {
    .groups {
      font-size: 12.5px;
    }

    .items {
      gap: 0 1.6ch;
    }
  }
</style>
