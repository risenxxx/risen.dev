---

/** Tools shipped and operated, not read about. An entry without a mark is a
    practice or a platform API that has no logo to borrow. */
const groups = [
  {
    title: 'Frontend',
    items: [
      { label: 'TypeScript' },
      { label: 'React' },
      { label: 'Next.js' },
      { label: 'Svelte 5' },
      { label: 'Astro' },
      { label: 'Tailwind' },
      { label: 'SSR' },
      { label: 'Effector' },
      { label: 'TanStack' },
      { label: 'Core Web Vitals' },
      { label: 'Web Workers' },
      { label: 'Canvas 2D' },
      { label: 'WCAG' },
      { label: 'Design systems' },
    ],
  },
  {
    title: 'Backend & data',
    items: [
      { label: '.NET 9' },
      { label: 'Node.js' },
      { label: 'Bun' },
      { label: 'Hono' },
      { label: 'Elysia' },
      { label: 'oRPC' },
      { label: 'PostgreSQL' },
      { label: 'Drizzle' },
      { label: 'ClickHouse' },
      { label: 'Redis' },
      { label: 'NATS' },
      { label: 'RabbitMQ' },
      { label: 'Temporal' },
      { label: 'Socket.IO' },
      { label: 'BullMQ' },
      { label: 'EF Core' },
      { label: 'OpenAPI' },
    ],
  },
  {
    title: 'Platform & ops',
    items: [
      { label: 'Kubernetes' },
      { label: 'Talos Linux' },
      { label: 'Docker' },
      { label: 'Pulumi' },
      { label: 'Terraform' },
      { label: 'Ansible' },
      { label: 'FluxCD' },
      { label: 'Cloudflare' },
      { label: 'Hetzner' },
      { label: 'DigitalOcean' },
      { label: 'GCP' },
      { label: 'Prometheus' },
      { label: 'Grafana' },
      { label: 'Sentry' },
      { label: 'Actions' },
    ],
  },
  {
    title: 'Further afield',
    items: [
      { label: 'Rust' },
      { label: 'Tauri 2' },
      { label: 'FFmpeg' },
      { label: 'WebAssembly' },
      { label: 'Win32 / Direct2D' },
      { label: 'USB HID' },
      { label: 'libmpv' },
      { label: 'Audio DSP / FFT' },
      { label: 'HDR / Dolby Vision' },
      { label: 'Applied cryptography' },
      { label: 'Telegram Mini Apps' },
    ],
  },
]
---

<section id="stack" data-object="stack">
  <div class="wrap">
    <h2 class="h-section" data-path="~/stack" data-reveal>Production-proven stack</h2>
    <p class="lede">
      Tools I have shipped and operated, not ones I have read about.<br class="br-wide" /> Chosen per
      constraint rather than per fashion.
    </p>

    <!--
      One list of lists, drawn two ways. On a desktop it is `ls -1 stack/*`:
      four columns, a directory each, a tool a line. Narrower it is `tree
      stack/`, in the ASCII the command prints without a Unicode locale —
      `|--` and `` `-- `` rather than box-drawing characters, which the page's
      mono does not have — with the tools wrapped a few to a line beside the
      trunk. Either way a reader without eyes gets the groups, not the lines.
    -->
    <p class="cmd cmd-tree mono" aria-hidden="true">$ tree stack/</p>
    <p class="cmd cmd-cols mono" aria-hidden="true">$ ls -1 stack/*</p>
    <ul class="groups mono" data-reveal style="--dl: 1">
      {
        groups.map((g, gi) => (
          <li class:list={['group', { last: gi === groups.length - 1 }]}>
            <h3>
              <span class="br" aria-hidden="true">{gi === groups.length - 1 ? '`-- ' : '|-- '}</span>
              {g.title.toLowerCase().replace(/ & /g, '-and-').replace(/\s+/g, '-')}/
            </h3>
            <ul class="items">
              {g.items.map((item) => (
                <li class="chip chip-lg">{item.label}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
section[id] {
    border-top: 1px solid var(--line);
    padding-block: clamp(44px, 5vw, 62px);
  }

  h2 {
    margin-bottom: 10px;
  }

  .lede {
    margin-bottom: 30px;
  }

  .cmd {
    font-size: 12.5px;
    color: var(--fg4);
    margin-bottom: 10px;
  }

  .cmd-cols {
    display: none;
  }

  .groups,
  .items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .groups {
    font-size: 13px;
    line-height: 1.9;
    max-width: 820px;
  }

  .group + .group {
    margin-top: 10px;
  }

  h3 {
    font-family: var(--mono);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--fg);
    white-space: pre;
  }

  .br {
    color: var(--fg4);
    font-weight: 400;
  }

  /*
    The tools, a few to a line, beside the trunk that runs on down from the
    branch. The trunk is the same `|` the branch is drawn with — a column of
    them in a pseudo-element, one per line at the list's own line height, so
    it sits in the branch's column at the branch's weight and colour, the
    way `tree` prints it. Rows have no gap between them so the bars keep
    step with the lines. The last directory has no trunk below it.
  */
  .items {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0 2ch;
    margin: 10px 0 18px;
    padding: 0 0 0 3ch;
    overflow: hidden;
    color: var(--fg-body);
  }

  .items::before {
    content: "|\A|\A|\A|\A|\A|\A|\A|\A|\A|\A|\A|\A";
    position: absolute;
    top: 0;
    left: 0;
    white-space: pre;
    font-weight: 400;
    color: var(--fg4);
  }

  .last .items::before {
    content: none;
  }

  .items :global(.chip::after) {
    content: none;
    margin: 0;
  }

  /* On a tablet the listing keeps two thirds of the width and the object
     rides the right third. */
  @media (min-width: 1000px) and (max-width: 1400px) {
    :global(html.ascii-object) .groups,
    :global(html.ascii-object) .lede {
      max-width: calc(100% - 272px);
    }
  }

  /* A desktop lists the directories side by side, a tool a line. */
  @media (min-width: 1401px) {
    .cmd-tree {
      display: none;
    }

    .cmd-cols {
      display: block;
    }

    .groups {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 28px;
      max-width: none;
    }

    :global(html.ascii-object) .groups {
      width: calc(100% - 300px);
    }

    .group + .group {
      margin-top: 0;
    }

    .br {
      display: none;
    }

    .items {
      display: grid;
      gap: 0;
      margin: 16px 0 0;
      padding: 0;
    }

    .items::before {
      content: none;
    }
  }

  @media (max-width: 620px) {
    .groups {
      font-size: 12.5px;
    }

    .items {
      gap: 0 1.6ch;
    }
  }
</style>
