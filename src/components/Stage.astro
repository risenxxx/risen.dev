---
/*
  The box a product preview stands in.

  A preview is drawn once at its real pixel size — the size the application's
  own chrome was measured at — and scaled down in steps as the column narrows.
  Scaling beats re-flowing: a player's controls rearranging themselves at 480 px
  would stop being a picture of that player.

  Every preview brings its own frame — four window chromes and one phone shell —
  so none of them gets a panel around it. A panel around a window is a frame
  around a frame, and the one preview that had a backdrop was the only thing on
  the page standing in a box.
*/
interface Props {
  w?: number
  h?: number
  /** No plinth: the preview already has a frame of its own. */
  bare?: boolean
}

const { w = 660, h = 372, bare = false } = Astro.props
---

<div class:list={['stage', { bare }]}>
  <div class="frame" style={`--w: ${w}; --h: ${h}`}>
    <div class="inner"><slot /></div>
  </div>
</div>

<style>
  .stage {
    container-type: inline-size;
    background: var(--s2);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 20px;
    /*
      A preview animates in place and nothing outside it depends on what it
      draws, so the browser is told it can keep the work inside: a repaint from
      a turning wheel or a filling seekbar stops at this box instead of being
      considered against the rest of the page.
    */
    contain: layout paint;
  }

  .stage.bare {
    background: none;
    border: 0;
    border-radius: 0;
    padding: 0;
  }

  /*
    `--k` is the ladder below, written once for a 660 px preview. `--fit` is
    what makes it right for a preview that is not 660: Gift Fight is a phone
    and is drawn 700 wide, and a ladder tuned to 660 pushed it past the column
    at half the breakpoints — invisibly, because the page clips its own
    overflow, until the gutter got small enough that the clipping showed.
    Correcting per instance means every preview ends up the same width as every
    other one, which is what they looked like they were doing anyway.
  */
  .frame {
    --k: 1;
    --fit: min(1, 660 / var(--w));
    --s: calc(var(--k) * var(--fit));
    height: calc(var(--h) * var(--s) * 1px);
    display: flex;
    justify-content: center;
  }

  .inner {
    width: calc(var(--w) * 1px);
    height: calc(var(--h) * 1px);
    flex: none;
    transform: scale(var(--s));
    transform-origin: top center;
  }

  @container (max-width: 672px) {
    .frame {
      --k: 0.96;
    }
  }

  @container (max-width: 655px) {
    .frame {
      --k: 0.93;
    }
  }

  @container (max-width: 615px) {
    .frame {
      --k: 0.84;
    }
  }

  @container (max-width: 560px) {
    .frame {
      --k: 0.75;
    }
  }

  @container (max-width: 500px) {
    .frame {
      --k: 0.66;
    }
  }

  @container (max-width: 440px) {
    .frame {
      --k: 0.57;
    }
  }

  @container (max-width: 380px) {
    .frame {
      --k: 0.5;
    }
  }

  @container (max-width: 348px) {
    .frame {
      --k: 0.47;
    }
  }

  @container (max-width: 316px) {
    .frame {
      --k: 0.43;
    }
  }

  @container (max-width: 288px) {
    .frame {
      --k: 0.39;
    }
  }

  @container (max-width: 260px) {
    .frame {
      --k: 0.35;
    }
  }

  @media (max-width: 640px) {
    .stage:not(.bare) {
      padding: 12px;
      border-radius: 16px;
    }
  }
</style>
