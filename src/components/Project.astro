---
import Icon from './Icon.astro'
import Sep from './Sep.astro'

export interface Link {
  label: string
  href: string
  primary?: boolean
  icon?: string
}

export interface Metric {
  value: string
  note: string
}

interface Props {
  /** The product's own accent, taken from its real interface rather than invented here. */
  accent: string
  title: string
  /** Domain and platform, as a caption under the name. */
  meta: [string, string]
  blurb: string
  /** Trusted, hand-written copy: emphasis and non-breaking spaces are markup. */
  bullets: string[]
  metrics?: Metric[]
  note?: string
  stack: { label: string; icon?: string }[]
  links: Link[]
  /** false puts the preview on the left; the sections alternate down the page. */
  reverse?: boolean
}

const {
  accent,
  title,
  meta,
  blurb,
  bullets,
  metrics = [],
  note,
  stack,
  links,
  reverse = false,
} = Astro.props
---

<section class:list={['project', { reverse }]} style={`--accent: ${accent}`}>
  <div class="wrap row">
    <div class="shot" data-reveal>
      <slot />
    </div>

    <div class="copy" data-reveal style="--dl: 1">
      <h3>{title}</h3>
      <p class="meta">
        <span class="dot" aria-hidden="true"></span>
        {meta[0]}
        <Sep />
        {meta[1]}
      </p>
      <p class="lede" set:html={blurb}></p>

      <ul class="points">
        {
          bullets.map((b) => (
            <li>
              <span class="tick" aria-hidden="true" />
              <span set:html={b} />
            </li>
          ))
        }
      </ul>

      {
        metrics.length > 0 && (
          <dl class="metrics">
            {metrics.map((m) => (
              <div>
                <dt set:html={m.value} />
                <dd>{m.note}</dd>
              </div>
            ))}
          </dl>
        )
      }

      {note && <p class="note" set:html={note} />}

      <ul class="stack">
        {
          stack.map((s) => (
            <li class="chip">
              {s.icon && <Icon name={s.icon} size={13} />}
              {s.label}
            </li>
          ))
        }
      </ul>

      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a class:list={['btn', l.primary ? 'btn-primary' : 'btn-ghost']} href={l.href}>
                {l.icon && <Icon name={l.icon} size={15} />}
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .project {
    border-top: 1px solid var(--line);
    padding-block: clamp(36px, 4.4vw, 56px);
  }

  .row {
    display: flex;
    align-items: center;
    gap: clamp(28px, 4vw, 60px);
  }

  .reverse .row {
    flex-direction: row-reverse;
  }

  .shot {
    width: 700px;
    flex: none;
    max-width: 100%;
  }

  .copy {
    flex: 1 1 0;
    min-width: 0;
  }

  h3 {
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.12;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 10px 0 18px;
    font-size: 14px;
    color: var(--fg2);
  }

  .meta .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .points {
    display: grid;
    gap: 12px;
    margin: 22px 0;
  }

  /*
    The blurb is the claim and the list is the evidence, so the blurb is the
    brighter of the two. It used to be the other way round, which read as an
    accident rather than a step down.
  */
  .lede {
    color: #e4e4ea;
  }

  .points li {
    display: flex;
    gap: 12px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--fg-body);
  }

  .points :global(em) {
    font-style: normal;
    color: var(--fg);
  }

  .tick {
    width: 11px;
    height: 1px;
    margin-top: 11px;
    background: var(--accent);
    flex: none;
  }

  .metrics {
    margin: 0 0 22px;
  }

  .note {
    max-width: 68ch;
    margin-bottom: 22px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg3);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 22px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* One column once the preview can no longer hold its own width: the preview
     goes first either way, because it is what makes somebody read the text. */
  @media (max-width: 1180px) {
    .row,
    .reverse .row {
      flex-direction: column;
      align-items: stretch;
    }

    .shot {
      width: 100%;
    }
  }
</style>
