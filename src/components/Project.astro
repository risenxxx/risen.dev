---
import Icon from './Icon.astro'
import { OBJECT_SIZE, sectionByKey } from '../ascii/sections'

export interface Link {
  label: string
  href: string
  primary?: boolean
  icon?: string
}

export interface Metric {
  value: string
  note: string
}

interface Props {
  /** The product's own accent, taken from its real interface rather than invented here. */
  accent: string
  title: string
  /**
   * Two tags under the name, in a fixed order: the field the product is in,
   * then the shape it takes. Keep to that — the first slot drifted into
   * business models and job titles ("SaaS", "Systems programming"), and a page
   * whose claim is breadth has to name a different domain in every one.
   */
  meta: [string, string]
  blurb: string
  /** Trusted, hand-written copy: emphasis and non-breaking spaces are markup. */
  bullets: string[]
  metrics?: Metric[]
  note?: string
  stack: { label: string }[]
  links: Link[]
  /** false puts the preview on the left; the sections alternate down the page. */
  reverse?: boolean
  /** The section's key for the ASCII object (src/ascii/sections.ts). */
  object?: string
}

const {
  accent,
  title,
  meta,
  blurb,
  bullets,
  metrics = [],
  note,
  stack,
  links,
  reverse = false,
  object,
} = Astro.props

/*
  Where the object rides a column inside the copy (sections.ts: a `column`
  place), the copy leaves it a lane down its right from the first paint —
  every block of the copy, down to the column's limit element, is padded by
  the object's width and a gap — and the preview gives up a little width. Both used to
  be done by the object when it arrived, which moved the text under the
  reader's eyes; now its arrival moves nothing.
*/
const column = object ? sectionByKey(object)?.glide.column : undefined
const laneSize = object ? (sectionByKey(object)?.glide.size ?? 1) : 1
/* The object's width, which the lane is sized from (see the style below). */
const lane = column ? `calc(100vh * ${(OBJECT_SIZE * laneSize).toFixed(3)})` : undefined
---

<section
  class:list={['project', { reverse, 'ascii-wide': !!column }]}
  style={`--accent: ${accent}${lane ? `; --lane: ${lane}` : ''}`}
  data-object={object}
>
  <div class="wrap row">
    <div class="shot" data-reveal>
      <slot />
    </div>

    <div class="copy" data-reveal style="--dl: 1">
      <h3>{title}</h3>
      <p class="meta">
        <span class="tag">{meta[0]}</span>
        <span class="tag">{meta[1]}</span>
      </p>
      <p class="lede" set:html={blurb}></p>

      <ul class="points">
        {
          bullets.map((b) => (
            <li>
              <span class="tick" aria-hidden="true" />
              <span set:html={b} />
            </li>
          ))
        }
      </ul>

      {
        metrics.length > 0 && (
          <dl class="metrics">
            {metrics.map((m) => (
              <div>
                <dt set:html={m.value} />
                <dd>{m.note}</dd>
              </div>
            ))}
          </dl>
        )
      }

      {note && <p class="note" set:html={note} />}

      <ul class="stack">
        {
          stack.map((s) => (
            <li class="chip">
              {s.label}
            </li>
          ))
        }
      </ul>

      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a class:list={['btn', l.primary ? 'btn-primary' : 'btn-ghost']} href={l.href} target="_blank" rel="noopener">
                {l.icon && <Icon name={l.icon} size={15} />}
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .project {
    border-top: 1px solid var(--line);
    padding-block: clamp(36px, 4.4vw, 56px);
  }

  .row {
    display: flex;
    align-items: center;
    gap: clamp(28px, 4vw, 60px);
  }

  .reverse .row {
    flex-direction: row-reverse;
  }

  .shot {
    width: 700px;
    flex: none;
    max-width: 100%;
  }

  .copy {
    flex: 1 1 0;
    min-width: 0;
  }

  h3 {
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.12;
  }

  /*
    Two tags rather than one line with a separator between them. The halves are
    not the same kind of thing — one is the field, the other is the shape the
    product takes — so a separator was promising a relation that is not always
    there, and once the column got narrow enough for both to wrap, the 3 px
    separator read as a bullet beside the 7 px accent dot. A tag wraps whole or
    not at all, and the gap does the separating.
  */
  /* The two tags are a comment under the name: the field, then the shape. */
  .meta {
    display: block;
    margin: 10px 0 18px;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.6;
    color: var(--fg3);
  }

  .meta::before {
    content: "# ";
    color: var(--fg4);
  }

  .tag {
    text-transform: lowercase;
  }

  .tag + .tag::before {
    content: "/";
    margin-inline: 9px;
    color: var(--fg4);
  }


  .points {
    display: grid;
    gap: 12px;
    margin: 22px 0;
  }

  /*
    The blurb is the claim and the list is the evidence, so the blurb is the
    brighter of the two. It used to be the other way round, which read as an
    accident rather than a step down.
  */
  .lede {
    color: #e4e4ea;
  }

  .points li {
    display: flex;
    gap: 12px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--fg-body);
  }

  .points :global(em) {
    font-style: normal;
    color: var(--fg);
  }

  /* The list's dash, in the amber: the product's own accent stays with the
     product, inside its preview. */
  .tick {
    width: 9px;
    height: 1.5px;
    margin-top: 11px;
    background: var(--amber);
    flex: none;
  }

  .metrics {
    margin: 0 0 22px;
  }

  .note {
    max-width: 60ch;
    margin-bottom: 22px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg3);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 22px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* One column once the preview can no longer hold its own width: the preview
     goes first either way, because it is what makes somebody read the text. */
  /*
    With the ASCII object. On a desktop a row whose preview is on the right
    puts the preview at the top of the row and the object under it, beside
    the metrics and chips; a row whose copy wraps round the object narrows
    its preview a little so the copy has room. From 1400 px down every row
    stacks for the object (the page's own stacking starts at 1180): the
    preview goes to the left and the copy leaves a column free down the
    right for the object to ride in.
  */
  @media (min-width: 1401px) {
    :global(html.ascii-object) .reverse .row {
      align-items: flex-start;
    }

    /* The heading's line box starts above its letters; the preview comes
       down to where the letters start. */
    :global(html.ascii-object) .reverse .shot {
      margin-top: 7px;
    }

    :global(html.ascii-object) .ascii-wide .shot {
      width: 620px;
    }

    /*
      The lane: the whole copy keeps clear of the object, down to the links,
      so the object has the full height of the copy to ride in. The object
      stands with its right side on the page's right edge, which is the
      copy's right edge too, so the lane is the object's width and a gap.
    */
    :global(html.ascii-object) .ascii-wide .copy {
      position: relative;
    }

    :global(html.ascii-object) .ascii-wide .copy > * {
      padding-right: calc(var(--lane) + 20px);
    }

    :global(html.ascii-object) .ascii-wide .copy > .metrics {
      max-width: none;
    }

  }

  @media (min-width: 1000px) and (max-width: 1400px) {
    :global(html.ascii-object) .row,
    :global(html.ascii-object) .reverse .row {
      flex-direction: column;
      align-items: stretch;
    }

    :global(html.ascii-object) .shot :global(.frame) {
      justify-content: flex-start;
    }

    /* The phone is centred inside its own stage; left with the rest. */
    :global(html.ascii-object) .shot :global(.device) {
      margin-inline: 0;
    }

    :global(html.ascii-object) .copy {
      padding-right: 272px;
    }
  }

  @media (max-width: 1180px) {
    .row,
    .reverse .row {
      flex-direction: column;
      align-items: stretch;
    }

    .shot {
      width: 100%;
    }
  }
</style>
