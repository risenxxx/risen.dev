---
import Approach from '../components/Approach.astro'
import Architecture from '../components/Architecture.astro'
import Contact from '../components/Contact.astro'
import Footer from '../components/Footer.astro'
import Hero from '../components/Hero.astro'
import IconSprite from '../components/IconSprite.astro'
import Nav from '../components/Nav.astro'
import Now from '../components/Now.astro'
import OpenSource from '../components/OpenSource.astro'
import Stack from '../components/Stack.astro'
import Work from '../components/Work.astro'
import Page from '../layouts/Page.astro'
import StructuredData from '../components/StructuredData.astro'
---

<Page>
  <!--
    The ASCII module is wanted the moment the page knows it can run it, not
    after the page's own script has arrived and asked for it: this hint
    fetches it alongside the fonts, one round trip sooner. At low priority,
    though — the page's own script and the fonts show the page, and on a thin
    connection the layer must not take their bandwidth. The path is put in by
    the build (astro.config.ts); in dev the placeholder stays and nothing is
    fetched ahead.
  -->
  <script is:inline>
    if (document.documentElement.classList.contains('ascii') && !'__ASCII_CHUNK__'.startsWith('__')) {
      const l = document.createElement('link')
      l.rel = 'modulepreload'
      l.href = '__ASCII_CHUNK__'
      l.fetchPriority = 'low'
      document.head.append(l)
    }
  </script>
  <StructuredData />
  <IconSprite />
  <Nav />
  <main>
    <Hero />
    <Now />
    <Architecture />
    <Work />
    <Approach />
    <Stack />
    <OpenSource />
    <Contact />
  </main>
  <Footer />
</Page>

<script>
  import { initMotion } from '../scripts/motion.ts'

  /*
    If anything in here fails, the page must not be left holding its own content
    hidden: dropping `.js` puts every reveal and every scene into its finished
    state, which is exactly the no-script rendering.
  */
  try {
    initMotion()
  } catch {
    document.documentElement.classList.remove('js')
  }

  /*
    The ASCII layer is the one thing on the page that is not small, so it is
    a separate module, fetched once the page has painted and only where the
    layout has signed it off. If it fails to load or to start, the classes
    come off and the page is the page without it.
  */
  const html = document.documentElement
  if (html.classList.contains('ascii')) {
    import('../ascii/ascii.ts')
      .then((m) => m.mount())
      .catch(() => html.classList.remove('ascii', 'ascii-object'))
  }
</script>
