---
import Page from '../layouts/Page.astro'
import { site } from '../data/site.ts'

/*
  The page that is not there. The saucer hovers over the copy — the one place
  it lives permanently rather than as the easter egg — at every width, since
  there is no copy beside it to make room for.
*/
---

<Page title={`Not found — ${site.domain}`} noindex objectAlways>
  <main class="missing" data-object="missing">
    <div class="copy">
      <h1 class="h-section" data-path="~/404">There is nothing at this address.</h1>
      <p class="lede">The page you were looking for has either moved or never existed.</p>
      <a class="btn btn-primary btn-lg" href="/">Back to the landing</a>
    </div>
  </main>

  <script>
    import { asciiOff, countAsciiOff } from '../scripts/off.ts'

    countAsciiOff()
    const html = document.documentElement
    if (html.classList.contains('ascii')) {
      import('../ascii/ascii.ts')
        .then((m) => m.mount())
        .catch((e: unknown) => {
          html.classList.remove('ascii', 'ascii-object')
          asciiOff('load', e)
        })
    }
  </script>
</Page>

<style>
  .missing {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--gut);
    text-align: center;
  }

  /* The room above the copy is the saucer's. */
  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-top: 300px;
  }

  .lede {
    max-width: 480px;
  }

  .btn {
    margin-top: 10px;
  }
</style>
