/*
  risen.dev is static files and one small worker: Workers static assets serve
  `dist`, and the worker answers `/s/*` alone. Pages was folded into Workers in wrangler 4, and
  deploying through an explicit config keeps the CLI from rewriting package.json
  on first run.

  `npm run build` before every deploy: canonical links, the sitemap and the
  noindex header all depend on SITE_ORIGIN / SITE_PREVIEW at build time
  (astro.config.ts), so a stale `dist` would deploy the wrong ones.
*/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "risen-dev",
  "compatibility_date": "2026-09-01",
  /*
    The worker is the page counter's own address, forwarded to Rybbit
    (worker/index.ts). `run_worker_first` names its prefix and nothing else:
    every other request is a static file, served without invoking the worker
    and without counting against the account's Workers requests.
  */
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/s/*"]
  },
  "routes": [{ "pattern": "risen.dev", "custom_domain": true }],
  // One address rather than two: a *.workers.dev copy of the whole site under
  // another name is something to keep out of search results for no benefit.
  "workers_dev": false,
  // Per-version preview addresses stay on, though — that is what a pull request
  // gets a link to. They are separate from `workers_dev`: production is only
  // ever served from risen.dev, while each uploaded version keeps its own
  // throwaway URL. The account still needs a workers.dev subdomain for them.
  "preview_urls": true
}
